# =============================================================================
# Aurianoa OS / Syority — live .gitignore
# Hygiene merge of the previous GitHub-template .gitignore with
# .gitignore.recommended (8 Sep 2026). Does not delete tracked files;
# already-tracked secrets/dumps still need git rm --cached (not done).
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies — regenerated by npm ci / npm install
# -----------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------------------------
# Next.js / build outputs — regenerated by npm run build
# -----------------------------------------------------------------------------
/.next/
**/.next/
/out/
/build
dist/
*.tsbuildinfo
next-env.d.ts

# Scratch Next app that contains only generated .next chunks (no product source)
/test-app/

# -----------------------------------------------------------------------------
# Environment & secrets — NEVER commit real credentials
# Keep .env.example tracked as the template (negated below).
# Previous rule was `.env*` which also ignored `.env.example`.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env*.example

# Plaintext password scratch files (seen historically as pw.txt)
pw.txt
*.password
*credentials*.json
service-account.json
**/service-account*.json
VERTEX_AI_SERVICE_ACCOUNT_JSON*
*.pem
*.p12
*.key
id_rsa
id_rsa.pub

# -----------------------------------------------------------------------------
# Runtime uploads & private user content — must live on volume / backup, not git
# -----------------------------------------------------------------------------
/uploads
/uploads/
/uploads/**

# Legacy / accidental public storage of tenant files (serve via authenticated APIs)
/public/doc-library/
/public/safety/
/public/logos/
/public/workpacks/

# -----------------------------------------------------------------------------
# TLS / Let's Encrypt material — generated on the VPS, never in git
# -----------------------------------------------------------------------------
/certbot/
/certbot/**

# -----------------------------------------------------------------------------
# Databases, dumps, and local Postgres artifacts
# -----------------------------------------------------------------------------
*.dump
*.sql.gz
*.backup
*.db
*.sqlite
*.sqlite3
/backups/
/backups/**

# -----------------------------------------------------------------------------
# Logs & local debug output
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logfile
dev.log
build.log
tsc.log
server_log.txt
server-log.txt
server_err.txt
out.txt
err.txt
vitest_out.txt
seed-output.txt
prisma_out.txt
prisma_err*.txt
prisma_error*.txt
prisma_debug.txt
prisma_gen_err.txt
installed.txt

# Stale TypeScript error dumps (never source of truth)
tsc_errors*.txt
tsc_output*.txt

# -----------------------------------------------------------------------------
# AI / extraction scratch & failed response dumps
# -----------------------------------------------------------------------------
failed_ai_response.txt
**/ai-cache/
**/.ai-cache/
tmp/
scratch/
*.scratch.*

# -----------------------------------------------------------------------------
# Test / coverage / tooling caches
# -----------------------------------------------------------------------------
/coverage
.nyc_output/
.turbo/
.cache/
.eslintcache
.vitest/

# -----------------------------------------------------------------------------
# OS / editor / IDE noise
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.antigravity/
*.swp
*~

# -----------------------------------------------------------------------------
# Vercel / cloud CLI local state
# -----------------------------------------------------------------------------
.vercel

# -----------------------------------------------------------------------------
# Prisma generated client (if emitted outside node_modules)
# Keep prisma/schema.prisma and prisma/migrations/** tracked.
# -----------------------------------------------------------------------------
/src/generated/prisma

# -----------------------------------------------------------------------------
# Optional local-only compose overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
.env.docker.local

# -----------------------------------------------------------------------------
# Local migration / backfill artifacts (R0.2 manifests, snapshots)
# -----------------------------------------------------------------------------
/var/
