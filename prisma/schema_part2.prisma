// ASSET HIERARCHY
model Plant {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String    @db.Uuid
  site            Site      @relation(fields: [site_id], references: [id])
  name            String
  code            String?
  description     String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("PlantCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  units           Unit[]
}

model Unit {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String    @db.Uuid
  site            Site      @relation(fields: [site_id], references: [id])
  plant_id        String    @db.Uuid
  plant           Plant     @relation(fields: [plant_id], references: [id])
  name            String
  code            String?
  description     String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("UnitCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  systems         System[]
  workpacks       Workpack[]
}

model System {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String    @db.Uuid
  site            Site      @relation(fields: [site_id], references: [id])
  unit_id         String    @db.Uuid
  unit            Unit      @relation(fields: [unit_id], references: [id])
  name            String
  code            String?
  description     String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("SystemCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  assets          Asset[]
}

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String    @db.Uuid
  site            Site      @relation(fields: [site_id], references: [id])
  system_id       String?   @db.Uuid
  system          System?   @relation(fields: [system_id], references: [id])
  tag_number      String
  name            String
  asset_type      String?
  sap_equipment_number String?
  description     String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("AssetCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  workpacks       Workpack[]

  @@unique([organization_id, tag_number])
}

// MASTER DATA
model Discipline {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  code            String
  color           String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("DisciplineCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  resource_types  ResourceType[]
  workpacks       Workpack[]
  activities      Activity[]
  punch_items     PunchListItem[]
  activity_libraries ActivityLibrary[]

  @@unique([organization_id, code])
}

model Contractor {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String?   @db.Uuid
  site            Site?     @relation(fields: [site_id], references: [id])
  name            String
  code            String?
  contact_person  String?
  contact_email   String?
  contact_phone   String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("ContractorCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  resources       Resource[]
  workpacks       Workpack[]
  activity_resources ActivityResource[]
}

model ResourceType {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  discipline_id   String?   @db.Uuid
  discipline      Discipline? @relation(fields: [discipline_id], references: [id])
  name            String
  code            String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("ResourceTypeCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  resources       Resource[]
  activity_resources ActivityResource[]
}

model Resource {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String?   @db.Uuid
  site            Site?     @relation(fields: [site_id], references: [id])
  resource_type_id String   @db.Uuid
  resource_type   ResourceType @relation(fields: [resource_type_id], references: [id])
  contractor_id   String?   @db.Uuid
  contractor      Contractor? @relation(fields: [contractor_id], references: [id])
  name            String
  employee_id     String?
  craft_code      String?
  is_active       Boolean?  @default(true)
  created_by      String?   @db.Uuid
  creator         User?     @relation("ResourceCreator", fields: [created_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  activity_resources ActivityResource[]
}

model Consumable {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  organization    Organization @relation(fields: [organization_id], references: [id])
  site_id         String?   @db.Uuid
  site            Site?     @relation(fields: [site_id], references: [id])
  category        String?
  sub_category    String?
  name            String
  material_number String?
  manufacturer    String?
  manufacturer_part_number String?
  unit_of_measure String
  specifications  String?   @db.Text
  reference_unit_cost Decimal? @db.Decimal(12, 2)
  is_active       Boolean?  @default(true)
  is_hazardous    Boolean?  @default(false)
  hsn_code        String?
  created_by      String    @db.Uuid
  creator         User      @relation("ConsumableCreator", fields: [created_by], references: [id])
  updated_by      String?   @db.Uuid
  updater         User?     @relation("ConsumableUpdater", fields: [updated_by], references: [id])
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  workpack_materials WorkpackMaterial[]
  ai_suggested_items AiSuggestedItem[]

  @@unique([organization_id, material_number])
  @@index([organization_id, category])
  @@index([organization_id, is_active])
}

