/// M8.9 — Event-scoped shift calendar consumed by the resource planning workspace.
/// Physically created by 20260829000000_add_resource_planning; declared here in OD9.1
/// so that the schema stops proposing to drop it. Transcribed from the live catalogue.
model ShiftDefinition {
  id               String             @id @db.Uuid
  organization_id  String             @db.Uuid
  event_id         String             @db.Uuid
  shift_name       String
  start_time       String
  end_time         String
  is_active        Boolean?           @default(true)
  created_by       String?            @db.Uuid
  updated_by       String?            @db.Uuid
  created_at       DateTime           @default(now())
  /// NOT NULL with no database default; @updatedAt supplies it from the client, which is
  /// what ResourcePlanningService.createShift relies on.
  updated_at       DateTime           @updatedAt
  deleted_at       DateTime?
  /// Field names below match ResourcePlanningService's include/select shape.
  resource_capacities ResourceCapacity[]
  event            Event              @relation(fields: [event_id], references: [id])
  organization     Organization       @relation(fields: [organization_id], references: [id])

  @@unique([event_id, shift_name])
  @@index([event_id])
  @@index([organization_id])
}

/// M8.9 — Per-day resource capacity ceiling used by resource levelling.
/// Physically created by 20260829000000_add_resource_planning; declared here in OD9.1.
model ResourceCapacity {
  id               String           @id @db.Uuid
  organization_id  String           @db.Uuid
  event_id         String           @db.Uuid
  resource_type_id String           @db.Uuid
  contractor_id    String?          @db.Uuid
  shift_id         String?          @db.Uuid
  target_date      DateTime         @db.Timestamptz(3)
  capacity_limit   Decimal          @db.Decimal(10, 2)
  notes            String?
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid
  created_at       DateTime         @default(now())
  /// NOT NULL with no database default; supplied by @updatedAt, which is what
  /// ResourcePlanningService.upsertCapacity relies on.
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  /// Field names below match ResourcePlanningService's include/select shape.
  contractor       Contractor?      @relation(fields: [contractor_id], references: [id])
  event            Event            @relation(fields: [event_id], references: [id])
  organization     Organization     @relation(fields: [organization_id], references: [id])
  resource_type    ResourceType     @relation(fields: [resource_type_id], references: [id])
  shift            ShiftDefinition? @relation(fields: [shift_id], references: [id])

  @@unique([event_id, resource_type_id, contractor_id, shift_id, target_date])
  @@index([event_id])
  @@index([organization_id])
  @@index([resource_type_id])
}

