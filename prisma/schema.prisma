  webhook_id      String?       @db.Uuid
  event           String
  status_code     Int?
  response        String?
  created_at      DateTime      @default(now())
  organization    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  webhook         WebhookConfig? @relation(fields: [webhook_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@map("webhook_logs")
}

/// Tenant API keys (hashed). Raw key is returned once at creation.
model ApiKey {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  key_hash        String
  last_used_at    DateTime?
  expires_at      DateTime?
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  createdByUser   User?        @relation(fields: [created_by], references: [id])

  @@index([organization_id])
  @@index([key_hash])
  @@map("api_keys")
}

// ── Knowledge Engine (Platform-only repository) ───────────────────────────

enum KnowledgeAssetCategory {
  ACTIVITY_CODE
  UDF_DEFINITION
  WORKPACK_TEMPLATE
  EQUIPMENT_TYPE
  RESOURCE_TYPE
  CERTIFICATE_TEMPLATE
  PRINT_SETTINGS
  QA_QC_TEMPLATE
  SAFETY_TEMPLATE
}

enum KnowledgeAssetStatus {
  INCOMING
  AI_ANALYSIS
  REVIEW_QUEUE
  APPROVED
  REJECTED
}

enum KnowledgeReviewDecision {
  APPROVE
  MERGE
  REJECT
  REQUEST_REVISION
}

/// Sanitized knowledge copies collected from tenant saves (never operational data).
model KnowledgeAsset {
  id                 String                 @id @default(uuid()) @db.Uuid
  status             KnowledgeAssetStatus   @default(INCOMING)
  category           KnowledgeAssetCategory
  asset_type         String
  title              String
  /// Fingerprint of sanitized payload for duplicate detection
  content_hash       String
  /// Tenant-identifying fields stripped; domain knowledge only
  sanitized_payload  Json
  source_industry    String?
  /// Opaque hash of source org — never store raw tenant id/name for privacy
  source_org_hash    String?
  similarity_score   Float?
  ai_suggestion      String?
  /// APPROVE-as-new | MERGE | REJECT hints from AI
  ai_recommendation  String?
  matched_asset_id   String?                @db.Uuid
  matched_asset      KnowledgeAsset?        @relation("KnowledgeDuplicate", fields: [matched_asset_id], references: [id])
  duplicate_of       KnowledgeAsset[]       @relation("KnowledgeDuplicate")
  first_seen_at      DateTime               @default(now())
  last_seen_at       DateTime               @default(now())
  times_seen         Int                    @default(1)
  times_used         Int                    @default(0)
  reviewer_notes     String?
  reviewed_by        String?                @db.Uuid
  reviewed_at        DateTime?
  promoted_at        DateTime?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  reviews            KnowledgeReviewLog[]

  @@index([status, category])
  @@index([content_hash])
  @@index([category, title])
  @@map("knowledge_assets")
}

model KnowledgeReviewLog {
  id            String                  @id @default(uuid()) @db.Uuid
  asset_id      String                  @db.Uuid
  decision      KnowledgeReviewDecision
  notes         String?
  reviewed_by   String?                 @db.Uuid
  created_at    DateTime                @default(now())
  asset         KnowledgeAsset          @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id, created_at])
  @@map("knowledge_review_logs")
}

// ── M7.1 Digital Plant Builder ─────────────────────────────────────────────

enum CandidateStatus {
  pending_review
  approved
  rejected
  merged
  edited
}

enum PlantProjectStatus {
  active
  completed
  archived
}

/// Digital Plant project — scoped container for extraction work on a Unit/System.
model DigitalPlantProject {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  site_id             String              @db.Uuid
  plant_id            String              @db.Uuid
  area_id             String?             @db.Uuid
  unit_id             String              @db.Uuid
  system_id           String?             @db.Uuid
  name                String
  description         String?
  status              PlantProjectStatus  @default(active)
  total_documents     Int                 @default(0)
  total_candidates    Int                 @default(0)
  approved_count      Int                 @default(0)
  rejected_count      Int                 @default(0)
  created_by          String              @db.Uuid
  updated_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  documents           PlantDocument[]
  candidates          ExtractionCandidate[]
  Organization        Organization        @relation(fields: [organization_id], references: [id])
  Site                Site                @relation(fields: [site_id], references: [id])
  Plant               Plant               @relation(fields: [plant_id], references: [id])
  Unit                Unit                @relation(fields: [unit_id], references: [id])

  @@index([organization_id, status])
  @@index([organization_id, site_id])
  @@map("digital_plant_projects")
}

/// Versioned engineering document (P&ID, PFD, GA, Isometric, OEM Manual, Datasheet, etc.)
model PlantDocument {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  project_id          String              @db.Uuid
  document_type       String              /// P&ID, PFD, GA, Equipment Layout, Isometric, OEM Manual, Datasheet, etc.
  drawing_number      String?
  title               String
  revision            String?             @default("0")
  issue_date          DateTime?           @db.Timestamptz(3)
  discipline          String?             /// Mechanical, Piping, Electrical, Instrumentation, Civil, Process
  status              String              @default("uploaded") /// uploaded, extracting, extracted, reviewed
  unit_id             String?             @db.Uuid
  system_id           String?             @db.Uuid
  original_filename   String
  stored_filename     String
  storage_path        String
  mime_type           String?
  file_size_bytes     BigInt?             @default(0)
  page_count          Int?
  version_number      Int                 @default(1)
  supersedes_id       String?             @db.Uuid
  ai_text_extracted   String?             /// OCR / AI-extracted full text
  uploaded_by         String              @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  project             DigitalPlantProject @relation(fields: [project_id], references: [id])
  candidates          ExtractionCandidate[]
  asset_links         AssetDocumentLink[]

  @@index([project_id, document_type])
  @@index([organization_id, drawing_number])
  @@map("plant_documents")
}

/// AI-extracted candidate object awaiting planner review. Never auto-committed.
model ExtractionCandidate {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  project_id          String              @db.Uuid
  source_document_id  String              @db.Uuid
  extraction_job_id   String?             @db.Uuid
  candidate_type      String              /// equipment, valve, pipeline, instrument, motor, pump, compressor, etc.
  tag_number          String
  description         String?
  confidence_score    Float?              @default(0)
  extracted_attributes Json               @default("{}") /// {manufacturer, model, size, rating, material, class, serial, ...}
  source_page         Int?
  source_region       String?             /// bounding box or region hint from AI
  status              CandidateStatus     @default(pending_review)
  approved_asset_id   String?             @db.Uuid
  merge_target_id     String?             @db.Uuid  /// If merged, which asset did we merge into
  reviewed_by         String?             @db.Uuid
  reviewed_at         DateTime?
  review_notes        String?
  import_batch_id     String?             /// If created from Excel import
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  project             DigitalPlantProject @relation(fields: [project_id], references: [id])
  source_document     PlantDocument       @relation(fields: [source_document_id], references: [id])
  review_actions      CandidateReviewAction[]

  @@index([project_id, status])
  @@index([organization_id, tag_number])
  @@index([source_document_id])
  @@index([extraction_job_id])
  @@map("extraction_candidates")
}

/// Every planner action on a candidate — audit trail + AI learning signal.
model CandidateReviewAction {
  id                  String              @id @default(uuid()) @db.Uuid
  candidate_id        String              @db.Uuid
  user_id             String              @db.Uuid
  action              String              /// approve, reject, merge, edit, bulk_approve, bulk_reject
  field_name          String?             /// Which field was edited (null for approve/reject)
  original_value      String?
  corrected_value     String?
  reason              String?
  confidence_before   Float?
  confidence_after    Float?
  created_at          DateTime            @default(now())
  candidate           ExtractionCandidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id, created_at])
  @@index([user_id, created_at])
  @@map("candidate_review_actions")
}

/// Many-to-many link between Asset and PlantDocument — permanent engineering knowledge.
model AssetDocumentLink {
  id                  String              @id @default(uuid()) @db.Uuid
  asset_id            String              @db.Uuid
  document_id         String              @db.Uuid
  link_type           String              @default("source") /// source, reference, oem_manual, datasheet, inspection, photo
  notes               String?
  created_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  asset               Asset               @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  document            PlantDocument       @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, document_id, link_type])
  @@index([asset_id])
  @@index([document_id])
  @@map("asset_document_links")
}

// ── M7.2 Engineering Scope Intelligence ────────────────────────────────────

enum IssueStatus {
  draft
  pending_review
  matched
  unmatched
  duplicate
  resolved
  rejected
}

enum IssuePriority {
  critical
  high
  medium
  low
  unclassified
}

/// Import batch — container for a set of issues from one source.
model IssueBatch {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  site_id             String?             @db.Uuid
  name                String              /// Human label, e.g. "Mech Dept Q3 2026"
  description         String?
  source_type         String              /// excel, csv, pdf, word, email, whatsapp, api, cmms, sap, maximo, manual, inspection
  source_filename     String?
  source_department   String?             /// Department that submitted this batch
  uploaded_by         String              @db.Uuid
  total_rows          Int                 @default(0)
  matched_count       Int                 @default(0)
  unmatched_count     Int                 @default(0)
  duplicate_count     Int                 @default(0)
  error_count         Int                 @default(0)
  status              String              @default("pending") /// pending, processing, completed, rolled_back
  column_mapping_id   String?             @db.Uuid
  ai_extraction_used  Boolean             @default(false)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  issues              EngineeringIssue[]
  Organization        Organization        @relation(fields: [organization_id], references: [id])

  @@index([organization_id, status])
  @@index([organization_id, source_department])
  @@map("issue_batches")
}

/// Core engineering issue — linked to Asset, classified, audited.
model EngineeringIssue {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  site_id             String?             @db.Uuid
  batch_id            String?             @db.Uuid
  issue_number        String?             /// Original issue number from source
  /// Raw equipment tag from source (before matching)
  equipment_tag_raw   String?
  equipment_desc_raw  String?
  /// Matched asset (null = unmatched or pending review)
  asset_id            String?             @db.Uuid
  match_confidence    Float?              /// 0.0–1.0 matching confidence
  match_method        String?             /// exact, normalized, fuzzy, manual, placeholder
  /// Hierarchy context (resolved from asset or from import)
  plant_id            String?             @db.Uuid
  unit_id             String?             @db.Uuid
  system_id           String?             @db.Uuid
  /// Issue content
  department          String?             /// Process, Maintenance, Inspection, Mechanical, etc.
  discipline          String?             /// AI-classified discipline
  problem             String              /// The engineering problem description
  recommendation      String?
  priority            IssuePriority       @default(unclassified)
  severity            String?             /// critical, major, minor, cosmetic
  status              IssueStatus         @default(draft)
  target_ta           String?             /// Target turnaround / event name (free text for now)
  originator          String?             /// Person who raised the issue
  raised_date         DateTime?           @db.Timestamptz(3)
  due_date            DateTime?           @db.Timestamptz(3)
  comments            String?
  /// AI enrichment
  ai_discipline       String?             /// AI-suggested discipline
  ai_discipline_confidence Float?
  ai_failure_mode     String?             /// AI-detected failure mode
  ai_category         String?             /// AI-recommended category
  ai_template_hint    String?             /// Suggested workpack template (future use, never auto-creates)
  ai_drawing_refs     String[]            @default([]) /// Drawing references found in text
  /// Metadata
  created_by          String?             @db.Uuid
  updated_by          String?             @db.Uuid
  reviewed_by         String?             @db.Uuid
  reviewed_at         DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  batch               IssueBatch?         @relation(fields: [batch_id], references: [id])
  asset               Asset?              @relation(fields: [asset_id], references: [id])
  Organization        Organization        @relation(fields: [organization_id], references: [id])
  attachments         IssueAttachment[]
  audit_logs          IssueAuditLog[]
  classifications     IssueClassification[]
  duplicates_as_a     IssueDuplicate[]    @relation("IssueDuplicateA")
  duplicates_as_b     IssueDuplicate[]    @relation("IssueDuplicateB")
  scope_links         ScopeItemIssueLink[]

  @@unique([organization_id, issue_number], name: "issue_org_number")
  @@index([organization_id, status])
  @@index([organization_id, department])
  @@index([organization_id, asset_id])
  @@index([batch_id])
  @@index([equipment_tag_raw])
  @@map("engineering_issues")
}

/// File attachment linked to an engineering issue.
model IssueAttachment {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  filename            String
  stored_path         String
  mime_type           String?
  file_size_bytes     Int?
  uploaded_by         String?             @db.Uuid
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id])
  @@map("issue_attachments")
}

/// Audit trail for every status change, edit, or merge on an issue.
model IssueAuditLog {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  user_id             String?             @db.Uuid
  action              String              /// create, update, match, unmatch, classify, merge, resolve, reject, attach
  field_name          String?
  old_value           String?
  new_value           String?
  notes               String?
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id, created_at])
  @@map("issue_audit_logs")
}

/// Detected duplicate pair with planner resolution.
model IssueDuplicate {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  issue_a_id          String              @db.Uuid
  issue_b_id          String              @db.Uuid
  similarity_score    Float               /// 0.0–1.0 text/semantic similarity
  similarity_method   String              /// text, ai_semantic, tag_match
  ai_reasoning        String?             /// AI explanation of why these are duplicates
  resolution          String?             /// merge_into_a, merge_into_b, keep_separate, rejected
  resolved_by         String?             @db.Uuid
  resolved_at         DateTime?
  created_at          DateTime            @default(now())
  issue_a             EngineeringIssue    @relation("IssueDuplicateA", fields: [issue_a_id], references: [id], onDelete: Cascade)
  issue_b             EngineeringIssue    @relation("IssueDuplicateB", fields: [issue_b_id], references: [id], onDelete: Cascade)

  @@unique([issue_a_id, issue_b_id])
  @@index([organization_id])
  @@map("issue_duplicates")
}

/// Persisted column mapping template for repeated imports.
model IssueColumnMapping {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  name                String              /// e.g. "SAP PM Export", "CMMS Standard"
  source_type         String              /// excel, csv, cmms, sap, maximo
  mappings            Json                /// { "Excel Column Name": "issue_field_name", ... }
  is_default          Boolean             @default(false)
  created_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([organization_id, source_type])
  @@map("issue_column_mappings")
}

/// AI classification result per issue — stores per-discipline confidence.
model IssueClassification {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  discipline          String              /// Mechanical, Inspection, Electrical, etc.
  confidence          Float               /// 0.0–1.0
  failure_mode        String?
  category            String?
  template_hint       String?             /// Suggested template name (never auto-creates)
  ai_model_used       String?
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id])
  @@map("issue_classifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// M7.3 — Shutdown Scope Manager
// ─────────────────────────────────────────────────────────────────────────────

enum ScopeStatus {
  draft
  review
  approved
  frozen
  closed
}

enum ScopeChangeType {
  added
  removed
  deferred
  cancelled
  modified
  emergency
  opportunity
}

/// Top-level scope container. 1:1 with Event. Owns all ScopeItems.
model ShutdownScope {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  event_id            String              @unique @db.Uuid
  site_id             String              @db.Uuid
  /// Scope metadata
  name                String              /// e.g. "TA-2028 Shutdown Scope"
  description         String?
  objectives          String?             /// Scope objectives / goals
  status              ScopeStatus         @default(draft)
  /// Planning dates
  freeze_date         DateTime?           @db.Timestamptz(3)
  frozen_at           DateTime?
  frozen_by           String?             @db.Uuid
  approved_at         DateTime?
  approved_by         String?             @db.Uuid
  closed_at           DateTime?
  closed_by           String?             @db.Uuid
  /// Budget placeholders
  budget_manhours     Int?
  budget_cost         Decimal?            @db.Decimal(15, 2)
  /// Aggregated stats (denormalized for dashboard)
  total_items         Int                 @default(0)
  total_estimated_hrs Int                 @default(0)
  /// Audit
  created_by          String              @db.Uuid
  updated_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// Relations
  event               Event               @relation(fields: [event_id], references: [id])
  organization        Organization        @relation(fields: [organization_id], references: [id])
  items               ScopeItem[]
  change_requests     ScopeChangeRequest[]
  deferrals           ScopeDeferral[]
  audit_logs          ScopeAuditLog[]
  packages            ScopePackage[]
  comparisons_as_a    ScopeComparison[]   @relation("ScopeCompareA")
  comparisons_as_b    ScopeComparison[]   @relation("ScopeCompareB")

  @@index([organization_id, status])
  @@map("shutdown_scopes")
}

/// Individual scope item — one asset's work for this shutdown.
model ScopeItem {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  scope_id            String              @db.Uuid
  /// Asset linkage (required — every scope item tied to an asset)
  asset_id            String              @db.Uuid
  /// Hierarchy context (denormalized from asset for fast filtering)
  plant_id            String?             @db.Uuid
  unit_id             String?             @db.Uuid
  system_id           String?             @db.Uuid
  /// Scope detail
  reason              String              /// Why this asset is in scope
  discipline          String?             /// Mechanical, Electrical, Inspection, etc.
  priority            String              @default("medium") /// critical, high, medium, low
  complexity          String              @default("standard") /// simple, standard, complex, critical
  requested_by        String?             /// Person or department who requested
  estimated_hours     Int                 @default(0)
  /// Template recommendation (advisory, never auto-creates workpack)
  template_id         String?             @db.Uuid
  template_name       String?             /// Denormalized for display
  /// AI enrichment
  ai_recommendation   String?             /// include / exclude
  ai_confidence       Float?
  ai_grouping_hint    String?             /// Suggested package grouping
  ai_missing_docs     String[]            @default([])
  ai_previous_ta      String?             /// Previous TA reference
  /// Planner notes
  planner_notes       String?
  /// Status tracking
  is_deferred         Boolean             @default(false)
  is_additional       Boolean             @default(false) /// Late addition / emergency / opportunity
  additional_type     String?             /// late_addition, emergency, opportunity
  /// Package assignment
  package_id          String?             @db.Uuid
  /// Sort & order
  sort_order          Int                 @default(0)
  /// Audit
  created_by          String              @db.Uuid
  updated_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// Relations
  scope               ShutdownScope       @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  asset               Asset               @relation("ScopeItemAsset", fields: [asset_id], references: [id])
  package             ScopePackage?       @relation(fields: [package_id], references: [id])
  issue_links         ScopeItemIssueLink[]
  deferrals           ScopeDeferral[]
  /// M7.4 — Workpack created from this scope item
  workpack_id         String?             @db.Uuid
  workpack            Workpack?           @relation(fields: [workpack_id], references: [id])

  @@index([scope_id, discipline])
  @@index([scope_id, priority])
  @@index([asset_id])
  @@index([package_id])
  @@unique([scope_id, asset_id], name: "scope_asset_unique")
  @@map("scope_items")
}

/// Many-to-many join: ScopeItem ↔ EngineeringIssue.
model ScopeItemIssueLink {
  id          String            @id @default(uuid()) @db.Uuid
  scope_item_id String          @db.Uuid
  issue_id    String            @db.Uuid
  created_at  DateTime          @default(now())
  scope_item  ScopeItem         @relation(fields: [scope_item_id], references: [id], onDelete: Cascade)
  issue       EngineeringIssue  @relation(fields: [issue_id], references: [id])

  @@unique([scope_item_id, issue_id])
  @@index([issue_id])
  @@map("scope_item_issue_links")
}

/// Post-freeze change request.
model ScopeChangeRequest {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  scope_id        String            @db.Uuid
  /// What changed
  change_type     ScopeChangeType
  scope_item_id   String?           @db.Uuid   /// Item being changed (null for additions)
  asset_id        String?           @db.Uuid   /// Asset for new additions
  /// Details
  title           String
  reason          String
  justification   String?
  estimated_hours Int?
  discipline      String?
  priority        String?
  /// Approval
  status          String            @default("pending") /// pending, approved, rejected
  submitted_by    String            @db.Uuid
  submitted_at    DateTime          @default(now())
  reviewed_by     String?           @db.Uuid
  reviewed_at     DateTime?
  review_notes    String?
  /// Applied
  applied_at      DateTime?
  applied_by      String?           @db.Uuid
  /// Audit
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  /// Relations
  scope           ShutdownScope     @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([scope_id, status])
  @@index([organization_id])
  @@map("scope_change_requests")
}

/// Deferred work — never deleted. Permanent record.
model ScopeDeferral {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  scope_id        String          @db.Uuid
  scope_item_id   String          @db.Uuid
  /// Deferral info
  reason          String
  deferred_by     String          @db.Uuid
  deferred_at     DateTime        @default(now())
  target_event    String?         /// Name of next TA (free text)
  target_event_id String?         @db.Uuid   /// Link to next event if known
  /// Carry-forward tracking
  carried_forward Boolean         @default(false)
  carried_to_scope_id String?     @db.Uuid
  carried_at      DateTime?
  /// Relations
  scope           ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  scope_item      ScopeItem       @relation(fields: [scope_item_id], references: [id])

  @@index([scope_id])
  @@index([organization_id])
  @@map("scope_deferrals")
}

/// Scope-level audit log.
model ScopeAuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  scope_id    String          @db.Uuid
  user_id     String?         @db.Uuid
  action      String          /// create, add_item, remove_item, update_item, freeze, approve, close, change_request, defer, carry_forward, clone
  entity_type String?         /// scope_item, change_request, deferral, package
  entity_id   String?         @db.Uuid
  old_value   String?
  new_value   String?
  notes       String?
  created_at  DateTime        @default(now())
  scope       ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([scope_id, created_at])
  @@map("scope_audit_logs")
}

/// Logical grouping of scope items for handover.
model ScopePackage {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  scope_id        String          @db.Uuid
  name            String          /// e.g. "Mechanical Package A", "Inspection — Vessels"
  package_type    String          @default("discipline") /// discipline, area, contractor, risk, custom
  discipline      String?
  area            String?
  contractor      String?
  risk_level      String?
  description     String?
  estimated_hours Int             @default(0)
  sort_order      Int             @default(0)
  created_by      String          @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  /// Relations
  scope           ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  items           ScopeItem[]

  @@index([scope_id])
  @@unique([scope_id, name], name: "scope_package_name")
  @@map("scope_packages")
}

/// Comparison snapshot between two shutdowns.
model ScopeComparison {
  id            String          @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  scope_a_id    String          @db.Uuid
  scope_b_id    String          @db.Uuid
  /// Summary counts
  total_added   Int             @default(0)
  total_removed Int             @default(0)
  total_deferred Int            @default(0)
  total_same    Int             @default(0)
  /// Detail stored as JSON for flexible display
  diff_detail   Json            @default("[]")
  created_by    String          @db.Uuid
  created_at    DateTime        @default(now())
  /// Relations
  scope_a       ShutdownScope   @relation("ScopeCompareA", fields: [scope_a_id], references: [id])
  scope_b       ShutdownScope   @relation("ScopeCompareB", fields: [scope_b_id], references: [id])

  @@index([organization_id])
  @@map("scope_comparisons")
}

// ═══════════════════════════════════════════════════════════════════════
// M7.4 — WORKPACK INTELLIGENCE ENGINE
// ═══════════════════════════════════════════════════════════════════════

// MaintenanceStrategy REMOVED per ADR-0012.
// Workpack Templates are the only reusable execution object.
// See: docs/adr/ADR-0012-Workpack-Template-Architecture.md

/// Workpack Instantiation — full traceability record for every workpack created via the Intelligence Engine.
model WorkpackInstantiation {
  id                    String             @id @default(uuid()) @db.Uuid
  organization_id       String             @db.Uuid
  /// Core references
  workpack_id           String             @unique @db.Uuid
  scope_item_id         String?            @db.Uuid
  scope_id              String?            @db.Uuid
  /// Template snapshot
  template_id           String?            @db.Uuid
  template_revision     Int?
  template_family_id    String?            @db.Uuid
  /// Asset context
  asset_id              String?            @db.Uuid
  event_id              String?            @db.Uuid
  /// Scores (computed, cached)
  readiness_score       Int                @default(0)
  compliance_score      Int                @default(100)
  readiness_detail      Json               @default("{}")
  compliance_detail     Json               @default("{}")
  /// AI context (advisory) — recommends templates only (ADR-0012)
  ai_recommendations    Json               @default("{}")
  ai_recommended_template String?
  /// Materialization counts
  activities_created    Int                @default(0)
  resources_created     Int                @default(0)
  materials_created     Int                @default(0)
  certificates_created  Int                @default(0)
  documents_attached    Int                @default(0)
  /// Audit
  instantiated_by       String             @db.Uuid
  instantiated_at       DateTime           @default(now())
  /// Relations
  workpack              Workpack           @relation(fields: [workpack_id], references: [id], onDelete: Cascade)

  @@index([scope_id])
  @@index([scope_item_id])
  @@index([organization_id])
  @@map("workpack_instantiations")
}

// ═══════════════════════════════════════════════════════════════════════
// WORK TYPE MASTER & TEMPLATE FAMILY (ADR-0012)
// ═══════════════════════════════════════════════════════════════════════

/// Work Type Master — structured work classification for templates and reporting.
/// Two-level taxonomy: Category (e.g. Mechanical) → Name (e.g. Bundle Pulling).
/// Belongs to Planning, NOT Asset Integrity.
model WorkType {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String?  @db.Uuid  /// null = platform-level
  /// Two-level taxonomy
  category        String   /// e.g. "Mechanical", "Rotating", "Valve", "Inspection"
  name            String   /// e.g. "Bundle Pulling", "Pump Overhaul", "Hydro Test"
  code            String   /// e.g. "MECH-BP", "ROT-PO", "VLV-HT"
  description     String?
  /// Ordering and status
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  /// Audit
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, code], name: "work_type_org_code")
  @@index([organization_id, category])
  @@map("work_types")
}

/// Template Family — groups related templates by equipment type and maintenance context.
/// Example: "Heat Exchanger Maintenance" family contains Bundle Pulling, Retubing, etc.
/// Planner workflow: Equipment → Equipment Type → Template Family → Template.
model TemplateFamily {
  id              String              @id @default(uuid()) @db.Uuid
  organization_id String?             @db.Uuid  /// null = platform-level
  /// Identity
  name            String              /// e.g. "Heat Exchanger Maintenance"
  code            String              /// e.g. "HX-MAINT"
  description     String?
  /// Equipment type linkage
  equipment_type  String              /// e.g. "Heat Exchanger", "Centrifugal Pump"
  /// Ordering and status
  sort_order      Int                 @default(0)
  is_active       Boolean             @default(true)
  /// Audit
  created_by      String?             @db.Uuid
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  /// Relations
  templates       workpack_templates[]

  @@unique([organization_id, code], name: "template_family_org_code")
  @@index([organization_id, equipment_type])
  @@map("template_families")
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6 — Notification & Communication Platform
// ═══════════════════════════════════════════════════════════════════════════════

/// Notification Provider — SMTP, SES, SendGrid, M365, etc.
/// Platform-wide: no org scope. Only one may be the default.
model notification_providers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    /// "Corporate SMTP", "SendGrid Prod"
  provider_type     String                    /// smtp | ses | sendgrid | m365 | mailgun | smtp_relay
  is_default        Boolean   @default(false)
  is_enabled        Boolean   @default(true)
  /// SMTP fields
  smtp_host         String?
  smtp_port         Int?      @default(587)
  smtp_secure       Boolean?  @default(false)
  smtp_username     String?
  smtp_password_enc String?                   /// Encrypted via @/lib/encryption
  /// General sender
  from_name         String?   @default("AURIANOA OS")
  from_email        String?
  reply_to          String?
  /// Reliability
  timeout_ms        Int?      @default(30000)
  max_retries       Int?      @default(3)
  /// Future: OAuth / API key fields
  api_key_enc       String?                   /// Encrypted
  oauth_config      Json?                     /// { tenant_id, client_id, ... }
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  delivery_logs     notification_delivery_logs[]
  queue_items       notification_queue[]

  @@index([is_default, is_enabled])
}

/// Notification Template — reusable email/SMS templates with variable substitution.
model notification_templates {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String    @unique         /// "password-reset", "workpack-approved"
  category          String                    /// authentication | planning | execution | reports | platform
  name              String                    /// "Password Reset"
  subject           String                    /// "Reset your password for {{company}}"
  html_body         String                    /// Full HTML with {{variable}} placeholders
  text_body         String?                   /// Plain text fallback
  variables         Json      @default("[]")  /// ["user_name", "reset_link", "company"]
  version           Int       @default(1)
  is_active         Boolean   @default(true)
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  rules             notification_rules[]
  queue_items       notification_queue[]
  delivery_logs     notification_delivery_logs[]

  @@index([category, is_active])
  @@index([slug])
}

/// Notification Rule — maps events to templates + channels + recipients.
/// Platform-wide rules have organization_id = null.
model notification_rules {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    /// "Workpack Approved → Email Planner"
  event_type        String                    /// workpack.approved | qa.assigned | password.reset
  channel           String    @default("email") /// email | sms | whatsapp | teams | push | webhook
  template_id       String    @db.Uuid
  is_enabled        Boolean   @default(true)
  organization_id   String?   @db.Uuid        /// null = platform-wide rule
  /// Conditions (future: JSON conditions engine)
  conditions        Json?                     /// { "workpack_type": "mechanical" }
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  template          notification_templates    @relation(fields: [template_id], references: [id])
  recipients        notification_rule_recipients[]

  @@index([event_type, is_enabled])
  @@index([organization_id])
}

/// Recipients attached to a notification rule.
model notification_rule_recipients {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id           String    @db.Uuid
  recipient_type    String                    /// user | role | group | email | actor
  recipient_value   String                    /// userId | "planner" | groupId | "john@co.com" | "triggered_by"
  /// Relations
  rule              notification_rules        @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id])
}

/// Reusable recipient groups: "Planning Team", "Shutdown Management", etc.
model notification_recipient_groups {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    /// "Planning Team", "Shutdown Management"
  description       String?
  organization_id   String?   @db.Uuid        /// null = platform-wide group
  members           Json      @default("[]")  /// [{ type: "user"|"role"|"email", value: "..." }]
  is_active         Boolean   @default(true)
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([organization_id, is_active])
}

/// Notification Queue — items waiting for delivery.
model notification_queue {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_id       String?   @db.Uuid
  template_id       String?   @db.Uuid
  channel           String    @default("email")
  recipient_email   String?
  recipient_name    String?
  subject           String
  html_body         String
  text_body         String?
  variables         Json?                     /// Resolved template variables
  attachments       Json?                     /// [{ filename, content_base64, mime_type }]
  status            String    @default("pending") /// pending | sending | sent | delivered | failed | retrying | cancelled
  priority          Int       @default(5)     /// 1=highest, 10=lowest
  attempts          Int       @default(0)
  max_attempts      Int       @default(3)
  last_error        String?
  smtp_response     String?
  scheduled_for     DateTime?                 /// For delayed / scheduled sends
  sent_at           DateTime?
  /// Context
  organization_id   String?   @db.Uuid
  triggered_by      String?   @db.Uuid
  event_type        String?                   /// The event that triggered this
  entity_type       String?                   /// "Workpack", "User", etc.
  entity_id         String?   @db.Uuid
  /// Audit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  provider          notification_providers?   @relation(fields: [provider_id], references: [id])
  template          notification_templates?   @relation(fields: [template_id], references: [id])

  @@index([status, scheduled_for])
  @@index([organization_id, status])
  @@index([created_at])
}

/// Auditable delivery log — one row per recipient per send attempt.
model notification_delivery_logs {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue_item_id     String?   @db.Uuid
  provider_id       String?   @db.Uuid
  template_id       String?   @db.Uuid
  channel           String    @default("email")
  recipient_email   String?
  recipient_name    String?
  subject           String
  status            String                    /// sent | delivered | failed | bounced
  attempts          Int       @default(1)
  smtp_response     String?
  message_id        String?                   /// SMTP Message-ID
  failure_reason    String?
  has_attachments   Boolean   @default(false)
  /// Context
  organization_id   String?   @db.Uuid
  event_type        String?
  entity_type       String?
  entity_id         String?   @db.Uuid
  /// Timing
  sent_at           DateTime  @default(now())
  delivered_at      DateTime?
  /// Retention
  expires_at        DateTime?                 /// Auto-cleanup after retention period
  /// Relations
  provider          notification_providers?   @relation(fields: [provider_id], references: [id])
  template          notification_templates?   @relation(fields: [template_id], references: [id])

  @@index([organization_id, sent_at])
  @@index([status])
  @@index([recipient_email])
  @@index([event_type])
  @@index([expires_at])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6A — Enterprise Report Builder
// ═══════════════════════════════════════════════════════════════════════════════

/// Report Category — top-level grouping (Planning, Shutdown, Execution, Management, Platform).
model report_categories {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @unique         /// "Planning", "Shutdown", "Execution", etc.
  slug              String    @unique         /// "planning", "shutdown", "execution"
  description       String?
  icon              String?                   /// Emoji or icon class
  sort_order        Int       @default(0)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  definitions       report_definitions[]
}

/// Report Definition — metadata-driven report definition.
/// Each definition describes what data to fetch, what sections to show, and what parameters to accept.
model report_definitions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id       String    @db.Uuid
  slug              String    @unique         /// "lookahead-24h", "executive-dashboard"
  name              String                    /// "24 Hour Look Ahead"
  description       String?                   /// User-facing description
  data_source_key   String                    /// Registry key: "planning.lookahead_24h"
  /// Configuration
  default_sections  Json      @default("[]")  /// ["executive_summary","kpis","progress"]
  default_output    String    @default("pdf") /// pdf | html | excel | csv
  supports_outputs  Json      @default("[\"html\",\"pdf\",\"excel\",\"csv\"]")
  default_layout_id String?   @db.Uuid
  /// Subject & filename templates with {{variable}} support
  subject_template  String?                   /// "Daily Progress - {{event}}"
  filename_template String?                   /// "{{event}}_{{unit}}_{{report}}_{{date}}.pdf"
  /// AI
  supports_ai_summary Boolean @default(false)
  ai_prompt_template  String?                 /// Custom prompt for AI summary generation
  /// Visibility
  is_system         Boolean   @default(false) /// System reports cannot be deleted by tenants
  is_active         Boolean   @default(true)
  is_draft          Boolean   @default(false) /// Draft definitions not visible to planners
  requires_permission String? @default("reporting:view")
  /// Versioning
  version           Int       @default(1)     /// Incremented on structural changes
  /// Ownership
  owner_id          String?   @db.Uuid        /// Definition owner (user ID)
  /// Scope
  organization_id   String?   @db.Uuid        /// null = platform-wide (available to all orgs)
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  category          report_categories          @relation(fields: [category_id], references: [id])
  default_layout    report_layouts?            @relation(fields: [default_layout_id], references: [id])
  parameters        report_definition_parameters[]
  sections          report_sections[]
  schedules         report_schedules[]
  generations       report_generations[]
  saved_views       report_saved_views[]

  @@index([category_id, is_active])
  @@index([organization_id])
  @@index([data_source_key])
}

/// Report Parameter — reusable filter parameters.
/// Examples: Company, Site, Unit, Area, System, Asset, Event, Contractor, Discipline, Date Range, Shift.
model report_parameters {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String    @unique         /// "company", "site", "unit", "date_range", "shift"
  name              String                    /// "Company", "Site", "Unit"
  description       String?
  param_type        String                    /// select | multi_select | date_range | date | text | number | boolean
  /// Dynamic options
  options_source    String?                   /// Prisma model to query: "Organization", "Site", "Unit", etc.
  options_static    Json?                     /// Static options: [{"value":"day","label":"Day Shift"},...]
  /// Defaults
  default_value     String?                   /// Default value or JSON for multi-values
  is_required       Boolean   @default(false)
  /// Ordering
  sort_order        Int       @default(0)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  definitions       report_definition_parameters[]
}

/// Junction: which parameters apply to which report definition.
model report_definition_parameters {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definition_id     String    @db.Uuid
  parameter_id      String    @db.Uuid
  is_required       Boolean   @default(false)   /// Override parameter-level default
  sort_order        Int       @default(0)
  /// Relations
  definition        report_definitions         @relation(fields: [definition_id], references: [id], onDelete: Cascade)
  parameter         report_parameters          @relation(fields: [parameter_id], references: [id], onDelete: Cascade)

  @@unique([definition_id, parameter_id])
  @@index([definition_id])
}

/// Report Section — configurable sections per report definition.
/// Planner chooses which sections to include when generating.
model report_sections {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  definition_id     String    @db.Uuid
  key               String                    /// "executive_summary", "kpis", "progress", "constraints"
  name              String                    /// "Executive Summary", "KPIs"
  description       String?
  section_type      String    @default("data") /// data | chart | kpi_cards | summary | signature | photos
  /// Chart config (if section_type = 'chart')
  chart_type        String?                   /// bar | pie | line | scurve | histogram | trend | heatmap
  chart_config      Json?                     /// { dataKey, xAxis, yAxis, colors, ... }
  /// Data source override (if different from definition)
  data_source_key   String?                   /// Override: "execution.punch_register"
  /// Display
  sort_order        Int       @default(0)
  is_default        Boolean   @default(true)  /// Included by default
  is_required       Boolean   @default(false) /// Cannot be deselected
  /// Relations
  definition        report_definitions         @relation(fields: [definition_id], references: [id], onDelete: Cascade)

  @@index([definition_id, sort_order])
}

/// Report Layout — reusable layout template with branding.
/// Includes company logo, header, footer, page settings, signature blocks.
model report_layouts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    /// "Corporate Standard", "Field Report"
  slug              String    @unique
  description       String?
  /// Branding
  logo_url          String?                   /// Override org logo
  primary_color     String?   @default("#0D2137")
  accent_color      String?   @default("#E8701A")
  header_html       String?                   /// Custom header HTML
  footer_html       String?                   /// Custom footer HTML with {{page}}, {{total_pages}}, {{date}}
  /// Page settings
  page_size         String    @default("A4")  /// A4 | Letter | A3
  orientation       String    @default("portrait") /// portrait | landscape
  margin_top        Int       @default(20)    /// mm
  margin_bottom     Int       @default(20)
  margin_left       Int       @default(15)
  margin_right      Int       @default(15)
  /// Typography
  font_family       String?   @default("Inter, Arial, sans-serif")
  font_size_base    Int       @default(12)    /// px
  /// Signature block
  show_signature    Boolean   @default(false)
  signature_labels  Json?                     /// ["Prepared By", "Reviewed By", "Approved By"]
  /// Visibility
  is_system         Boolean   @default(false)
  is_active         Boolean   @default(true)
  organization_id   String?   @db.Uuid        /// null = platform-wide
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  definitions       report_definitions[]

  @@index([organization_id, is_active])
}

/// Report Schedule — business-friendly scheduled report delivery.
/// No cron syntax exposed to user. Frequency + time/day fields drive scheduling.
model report_schedules {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  definition_id     String    @db.Uuid
  name              String                    /// "Daily Progress — Unit A"
  /// Schedule config (business-friendly — NO cron exposed)
  frequency         String                    /// manual | hourly | daily | weekly | monthly | event_triggered
  delivery_time     String?   @default("06:00")  /// HH:mm (24h) — when to deliver
  day_of_week       Int?                      /// 0=Sun..6=Sat — for weekly
  day_of_month      Int?                      /// 1-28 — for monthly
  event_trigger     String?                   /// Event type for event_triggered: "workpack.completed"
  timezone          String    @default("UTC")
  /// Report configuration
  output_format     String    @default("pdf") /// pdf | html | excel | csv
  layout_id         String?   @db.Uuid
  selected_sections Json      @default("[]")  /// ["executive_summary","kpis","progress"]
  parameters        Json      @default("{}")  /// Resolved parameter values: { "unit": "U-100", "date_range": "today" }
  include_ai_summary Boolean  @default(false)
  /// Saved view — pull parameters from saved view at trigger time
  saved_view_id     String?   @db.Uuid
  /// Subject and filename
  subject_template  String?                   /// Override definition default
  filename_template String?                   /// Override definition default
  /// State
  is_active         Boolean   @default(true)
  last_run_at       DateTime?
  next_run_at       DateTime?
  run_count         Int       @default(0)
  last_error        String?
  /// Audit
  created_by        String    @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  definition        report_definitions         @relation(fields: [definition_id], references: [id])
  saved_view        report_saved_views?        @relation(fields: [saved_view_id], references: [id])
  recipients        report_schedule_recipients[]

  @@index([organization_id, is_active])
  @@index([frequency, is_active])
  @@index([next_run_at])
}

/// Recipients for a scheduled report. Supports To/CC/BCC.
model report_schedule_recipients {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id       String    @db.Uuid
  recipient_type    String                    /// user | role | group | email
  recipient_value   String                    /// userId | "planner" | groupId | "john@co.com"
  delivery_type     String    @default("to") /// to | cc | bcc
  /// Relations
  schedule          report_schedules           @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id])
}

/// Report Generation — audit trail for every report generated.
/// One row per generation event (manual or scheduled).
model report_generations {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  definition_id     String    @db.Uuid
  schedule_id       String?   @db.Uuid        /// null for manual/ad-hoc generations
  /// Configuration snapshot
  output_format     String                    /// pdf | html | excel | csv
  layout_id         String?   @db.Uuid
  selected_sections Json      @default("[]")
  parameters        Json      @default("{}")  /// Resolved parameter values at generation time
  included_ai       Boolean   @default(false)
  /// Subject and filename (resolved)
  resolved_subject  String?
  resolved_filename String?
  /// Output
  status            String    @default("pending") /// pending | generating | completed | failed | cancelled
  file_path         String?                   /// Path to generated file
  file_size_bytes   Int?
  html_content      String?                   /// Stored HTML for preview
  error_message     String?
  /// Enriched execution data (M7.6B)
  record_count      Int?                      /// Number of data records in the report
  retry_count       Int       @default(0)     /// Retry attempts
  notification_id   String?   @db.Uuid        /// Notification queue item ID
  smtp_message_id   String?                   /// SMTP message ID for delivery tracking
  saved_view_id     String?   @db.Uuid        /// Saved view used (if any)
  /// Timing
  started_at        DateTime?
  completed_at      DateTime?
  duration_ms       Int?
  /// Data Provenance & Snapshotting
  dataset_hash      String?                   /// Hash of the immutable ReportDataset
  dataset_path      String?                   /// Path/URI to the snapshot JSON dataset
  filters_applied   Json?      @default("{}") /// The precise filters applied during generation
  /// Delivery tracking (links to notification_queue)
  notification_queue_ids Json? @default("[]") /// UUIDs of notification_queue items created
  /// Audit
  generated_by      String    @db.Uuid
  created_at        DateTime  @default(now())
  /// Relations
  definition        report_definitions         @relation(fields: [definition_id], references: [id])
  artifacts         report_artifacts[]

  @@index([organization_id, created_at])
  @@index([definition_id])
  @@index([status])
  @@index([schedule_id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6B — Enterprise Report Engine Extensions
// ═══════════════════════════════════════════════════════════════════════════════

/// Branding Profile — company-level branding configuration.
/// Separate from layouts; layouts define page structure, branding defines visual identity.
/// Resolution chain: Layout → Branding Profile → Organization defaults → Platform defaults.
model report_branding_profiles {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  name              String                    /// "Corporate Standard", "Field Operations"
  slug              String    @unique
  description       String?
  /// Visual identity
  logo_url          String?                   /// Company logo URL
  logo_width_px     Int?      @default(180)
  logo_height_px    Int?      @default(50)
  /// Header / Footer
  header_html       String?                   /// Custom header with {{orgName}}, {{reportTitle}}
  footer_html       String?                   /// Custom footer with {{page}}, {{total_pages}}, {{date}}
  /// Company info (printed on reports)
  company_name      String?
  company_address   String?
  company_phone     String?
  company_email     String?
  company_website   String?
  /// Theme
  primary_color     String?   @default("#0D2137")
  secondary_color   String?   @default("#1E3A5F")
  accent_color      String?   @default("#E8701A")
  background_color  String?   @default("#FFFFFF")
  text_color        String?   @default("#1F2937")
  /// Typography
  font_family       String?   @default("Inter, Arial, sans-serif")
  heading_font      String?   @default("Inter, Arial, sans-serif")
  font_size_base    Int       @default(12)
  /// Signatures
  signature_block   Boolean   @default(false)
  signature_labels  Json?                     /// ["Prepared By","Reviewed By","Approved By"]
  /// Legal
  disclaimer_text   String?                   /// Printed at bottom of every report
  confidentiality   String?   @default("CONFIDENTIAL") /// "CONFIDENTIAL" | "INTERNAL" | "PUBLIC" | custom
  /// State
  is_default        Boolean   @default(false) /// One default per org
  is_active         Boolean   @default(true)
  /// Audit
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([organization_id, slug])
  @@index([organization_id, is_active])
}

/// Saved Report View — planner's saved parameter sets.
/// Reusable by schedules; avoids re-entering filters each time.
model report_saved_views {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  definition_id     String    @db.Uuid
  user_id           String    @db.Uuid        /// Owner of this view
  /// View config
  name              String                    /// "Unit 11 Daily Progress"
  description       String?
  parameters        Json      @default("{}")  /// Saved parameter values
  selected_sections Json      @default("[]")  /// Saved section selections
  output_format     String    @default("pdf")
  layout_id         String?   @db.Uuid
  include_ai        Boolean   @default(false)
  /// Visibility
  is_shared         Boolean   @default(false) /// If true, visible to all users in the org
  is_active         Boolean   @default(true)
  /// Audit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  definition        report_definitions         @relation(fields: [definition_id], references: [id])
  schedules         report_schedules[]

  @@index([organization_id, user_id])
  @@index([definition_id])
}

/// Report Artifact — managed storage for generated report outputs.
/// Every successful generation produces one or more artifacts.
/// Supports download, re-send, retention policy, and expiration.
model report_artifacts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  generation_id     String    @db.Uuid
  definition_id     String    @db.Uuid
  /// File info
  filename          String                    /// "lookahead_24h_2026-07-30.pdf"
  content_type      String                    /// "application/pdf", "text/csv", "application/vnd.openxmlformats..."
  file_size_bytes   Int?
  /// Storage — small files in DB, large files on disk/cloud
  file_data         Bytes?                    /// Binary file data (for files <10MB)
  file_path         String?                   /// External storage path (for larger files)
  html_snapshot     String?                   /// HTML snapshot for preview
  /// Metadata
  output_format     String                    /// pdf | html | excel | csv
  record_count      Int?                      /// Number of data records
  page_count        Int?                      /// Number of pages (for PDF)
  /// Retention
  expires_at        DateTime?                 /// Auto-cleanup after this date
  is_archived       Boolean   @default(false)
  /// Delivery tracking
  download_count    Int       @default(0)
  last_downloaded_at DateTime?
  last_resent_at    DateTime?
  /// Audit
  created_by        String    @db.Uuid
  created_at        DateTime  @default(now())
  /// Relations
  generation        report_generations         @relation(fields: [generation_id], references: [id])

  @@index([organization_id, created_at])
  @@index([generation_id])
  @@index([definition_id])
  @@index([expires_at])
}

/// Report Execution Metrics — pre-aggregated metrics for the execution dashboard.
/// Updated after each generation completes.
model report_execution_metrics {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String?   @db.Uuid        /// null = platform-wide metrics
  /// Period
  period_type       String                    /// daily | weekly | monthly
  period_start      DateTime
  period_end        DateTime
  /// Counts
  total_generated   Int       @default(0)
  total_completed   Int       @default(0)
  total_failed      Int       @default(0)
  total_retried     Int       @default(0)
  /// Timing
  avg_duration_ms   Int?
  max_duration_ms   Int?
  min_duration_ms   Int?
  /// Delivery
  total_delivered   Int       @default(0)
  avg_delivery_ms   Int?
  /// Top reports (JSON array)
  top_definitions   Json?                     /// [{id, name, count}]
  top_schedules     Json?                     /// [{id, name, count}]
  /// Audit
  computed_at       DateTime  @default(now())

  @@unique([organization_id, period_type, period_start])
  @@index([period_type, period_start])
}

/// Report Data Provider — self-documenting registry of registered data providers.
/// Each provider maps a key to a class that fetches structured data from business services.
/// Future modules register new providers without modifying core logic.
model report_data_providers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String    @unique         /// "planning.lookahead_24h", "shutdown.scope_register"
  name              String                    /// "24 Hour Look Ahead"
  category          String                    /// "planning", "shutdown", "execution", "management", "platform"
  description       String?
  /// Provider metadata
  provider_class    String?                   /// "PlanningLookahead24hProvider" — class name
  module            String?                   /// "core" | "rbi" | "corrosion" — source module
  /// Capabilities
  supports_streaming Boolean  @default(false)
  supports_pagination Boolean @default(false)
  max_rows          Int?                      /// Recommended max rows
  /// Schema
  output_schema     Json?                     /// JSON Schema of output structure
  required_params   Json?                     /// ["site", "event"] — required parameter keys
  optional_params   Json?                     /// ["contractor", "discipline"]
  /// State
  is_active         Boolean   @default(true)
  is_system         Boolean   @default(true)
  /// Audit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6C — Operational Intelligence Studio (OIS)
// ═══════════════════════════════════════════════════════════════════════════════

/// Widget Definition — registry entry for a widget type.
/// Each definition describes what visualization to render, which provider supplies data,
/// what filters are supported, and what capabilities the widget exposes.
/// System widgets are platform-provided; org widgets are tenant-created.
model ois_widget_definitions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String    @unique         /// "safety_trir_gauge", "planning_lookahead_table"
  name                  String                    /// "TRIR Gauge", "24hr Look Ahead"
  description           String?
  category              String                    /// "safety", "planning", "execution", "management", "workforce"
  icon                  String?                   /// Emoji or icon class: "🦺", "📊"
  /// Data source
  provider_key          String                    /// ProviderRegistry key: "safety.kpi_summary"
  /// Visualization
  visualization_type    String                    /// line | area | bar | stacked_bar | pie | donut | gauge | matrix | heatmap | timeline | kpi_card | progress_card | status_card | data_table | hierarchy_table | pivot_table | tree_grid | scurve | evm | gantt_summary
  default_config        Json      @default("{}")  /// Default chart/table/card config
  /// Capabilities
  supported_filters     Json      @default("[]")  /// ["event", "unit", "contractor", "date_range"]
  supports_ai           Boolean   @default(false)
  supports_export       Boolean   @default(true)
  supports_print        Boolean   @default(true)
  supports_drilldown    Boolean   @default(false)
  supports_threshold    Boolean   @default(false)
  refresh_interval_sec  Int       @default(300)   /// Default refresh in seconds (5 min)
  /// Metadata
  version               Int       @default(1)
  author                String?                   /// "SYORITY" for system widgets
  permissions_required  String?   @default("ois:widget.view")
  /// Scope
  is_system             Boolean   @default(false) /// System widgets cannot be deleted by tenants
  is_active             Boolean   @default(true)
  organization_id       String?   @db.Uuid        /// null = platform-wide widget
  /// Audit
  created_by            String?   @db.Uuid
  updated_by            String?   @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  /// Relations
  dashboard_widgets     ois_dashboard_widgets[]

  @@index([category, is_active])
  @@index([provider_key])
  @@index([organization_id])
}

/// Dashboard Definition — metadata for a dashboard, cockpit, TV board, or meeting view.
/// All surface types share this model; dashboard_type discriminates behavior.
model ois_dashboard_definitions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String    @unique         /// "director-cockpit", "safety-dashboard"
  name                  String                    /// "Director Cockpit"
  description           String?
  dashboard_type        String    @default("dashboard") /// dashboard | cockpit | tv | meeting
  category              String?                   /// "planning", "safety", "executive"
  icon                  String?                   /// "🎛️"
  /// Layout
  layout_config         Json      @default("{}")  /// Global layout settings (grid cols, theme, responsive breakpoints)
  page_count            Int       @default(1)
  /// State
  is_template           Boolean   @default(false) /// Template dashboards can be cloned by tenants
  is_published          Boolean   @default(false) /// Draft → Published → Archived
  is_archived           Boolean   @default(false)
  is_system             Boolean   @default(false) /// System templates cannot be deleted
  /// Versioning
  version               Int       @default(1)
  revision_notes        String?
  /// Branding
  branding_profile_id   String?   @db.Uuid
  /// Theme
  theme                 String    @default("light") /// light | dark
  /// Scope
  organization_id       String?   @db.Uuid        /// null = platform-wide template
  owner_id              String?   @db.Uuid        /// Dashboard owner (user)
  /// Audit
  created_by            String?   @db.Uuid
  updated_by            String?   @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  /// Relations
  pages                 ois_dashboard_pages[]
  widgets               ois_dashboard_widgets[]
  versions              ois_dashboard_versions[]
  shares                ois_dashboard_shares[]
  schedules             ois_dashboard_schedules[]
  snapshots             ois_dashboard_snapshots[]
  tv_sessions           ois_tv_sessions[]

  @@index([organization_id, is_published])
  @@index([dashboard_type, is_published])
  @@index([is_template, is_published])
}

/// Dashboard Page — multi-page dashboard support.
/// Each page has its own grid configuration and set of widgets.
model ois_dashboard_pages {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  page_number           Int       @default(1)
  title                 String?                   /// "Overview", "Safety KPIs", "Progress"
  /// Grid config
  grid_columns          Int       @default(12)
  grid_row_height       Int       @default(80)    /// pixels per grid row
  background_color      String?
  /// State
  is_active             Boolean   @default(true)
  sort_order            Int       @default(0)
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  widgets               ois_dashboard_widgets[]

  @@index([dashboard_id, sort_order])
}

/// Dashboard Widget — a widget instance placed on a dashboard page.
/// Contains grid position, size, overrides, and provider parameters.
model ois_dashboard_widgets {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  page_id               String?   @db.Uuid        /// null = first page
  widget_definition_id  String    @db.Uuid
  /// Grid position (react-grid-layout compatible)
  grid_x                Int       @default(0)
  grid_y                Int       @default(0)
  grid_w                Int       @default(4)     /// Width in grid columns
  grid_h                Int       @default(3)     /// Height in grid rows
  min_w                 Int?      @default(2)
  min_h                 Int?      @default(2)
  /// Customization overrides
  title_override        String?                   /// Override widget default title
  subtitle              String?
  icon_override         String?
  color_override        String?                   /// Override primary color
  /// Data configuration
  provider_params       Json      @default("{}")  /// Resolved filter values: { "event": "uuid", "unit": "CDU" }
  visualization_config  Json      @default("{}")  /// Chart-specific config: { "chartType": "bar", "xAxis": "date" }
  /// Thresholds & conditional formatting
  threshold_config      Json?                     /// { "warning": 80, "danger": 95, "direction": "above" }
  conditional_colors    Json?                     /// [{ "field": "status", "value": "Open", "color": "#DC2626" }]
  /// Formatting
  number_format         String?                   /// "0,0.00" | "0%" | "$0,0"
  date_format           String?                   /// "YYYY-MM-DD" | "DD/MM/YYYY"
  /// Display
  show_header           Boolean   @default(true)
  show_footer           Boolean   @default(false)
  footer_html           String?                   /// Custom footer HTML
  /// Refresh
  refresh_interval_override Int?                  /// Override widget default (seconds)
  /// State
  is_visible            Boolean   @default(true)
  sort_order            Int       @default(0)
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  page                  ois_dashboard_pages?       @relation(fields: [page_id], references: [id], onDelete: SetNull)
  widget_definition     ois_widget_definitions     @relation(fields: [widget_definition_id], references: [id])

  @@index([dashboard_id])
  @@index([page_id])
  @@index([widget_definition_id])
}

/// Dashboard Version — snapshot of dashboard layout for version history.
/// Enables undo, rollback, and version comparison.
model ois_dashboard_versions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  version               Int                       /// Sequential version number
  snapshot              Json                      /// Full layout clone: pages + widgets + config
  change_summary        String?                   /// "Added safety widget, moved progress chart"
  /// Audit
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now())
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@unique([dashboard_id, version])
  @@index([dashboard_id])
}

/// Dashboard Share — access control for sharing dashboards with users/roles/orgs.
model ois_dashboard_shares {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  shared_with_type      String                    /// user | role | organization
  shared_with_value     String                    /// userId | roleName | orgId
  permission            String    @default("view") /// view | edit
  /// Audit
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now())
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@unique([dashboard_id, shared_with_type, shared_with_value])
  @@index([dashboard_id])
}

/// Dashboard Schedule — scheduled dashboard delivery via the Notification Platform.
/// Reuses the same frequency/time model as report_schedules.
model ois_dashboard_schedules {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  organization_id       String    @db.Uuid
  name                  String                    /// "Morning Safety Snapshot"
  /// Schedule config (business-friendly — NO cron exposed)
  frequency             String                    /// manual | hourly | daily | weekly | monthly | event_triggered
  delivery_time         String?   @default("06:00") /// HH:mm (24h)
  day_of_week           Int?                      /// 0=Sun..6=Sat — for weekly
  day_of_month          Int?                      /// 1-28 — for monthly
  timezone              String    @default("UTC")
  /// Output
  output_format         String    @default("pdf") /// pdf | html | excel | png
  /// State
  is_active             Boolean   @default(true)
  last_run_at           DateTime?
  next_run_at           DateTime?
  run_count             Int       @default(0)
  last_error            String?
  /// Audit
  created_by            String    @db.Uuid
  updated_by            String?   @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  recipients            ois_dashboard_schedule_recipients[]

  @@index([organization_id, is_active])
  @@index([next_run_at])
}

/// Recipients for scheduled dashboard delivery. Supports To/CC/BCC.
model ois_dashboard_schedule_recipients {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id           String    @db.Uuid
  recipient_type        String                    /// user | role | group | email
  recipient_value       String                    /// userId | "planner" | groupId | "john@co.com"
  delivery_type         String    @default("to")  /// to | cc | bcc
  /// Relations
  schedule              ois_dashboard_schedules    @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id])
}

/// Dashboard Snapshot — generated output artifact for export/delivery.
/// Reuses the same storage pattern as report_artifacts.
model ois_dashboard_snapshots {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  organization_id       String    @db.Uuid
  /// File info
  output_format         String                    /// pdf | html | excel | png
  filename              String                    /// "safety-dashboard_2026-07-30.pdf"
  content_type          String                    /// "application/pdf"
  file_size_bytes       Int?
  /// Storage
  file_data             Bytes?                    /// Binary file data (< 10MB)
  file_path             String?                   /// External storage path
  html_snapshot         String?                   /// HTML snapshot for preview
  page_count            Int?
  /// Audit
  generated_by          String    @db.Uuid
  expires_at            DateTime?                 /// Auto-cleanup
  created_at            DateTime  @default(now())
  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@index([dashboard_id])
  @@index([organization_id, created_at])
  @@index([expires_at])
}

/// TV Session — active TV/kiosk mode session with a shareable session code.
model ois_tv_sessions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dashboard_id          String    @db.Uuid
  organization_id       String    @db.Uuid
  session_code          String    @unique         /// 6-char alphanumeric code for QR/URL join
  /// Config
  rotation_interval_sec Int       @default(30)    /// Seconds between page rotations
  auto_refresh_sec      Int       @default(60)    /// Seconds between data refresh
  /// State
  is_active             Boolean   @default(true)
  started_by            String    @db.Uuid
  started_at            DateTime  @default(now())
  expires_at            DateTime                  /// Auto-expire after duration

  /// Relations
  dashboard             ois_dashboard_definitions  @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)

  @@index([session_code])
  @@index([organization_id, is_active])
  @@index([expires_at])
}

/// Widget Data Cache — shared cache for provider data.
/// Multiple widgets requesting the same provider+params share one cache entry.
model ois_widget_data_cache {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_key          String                    /// ProviderRegistry key
  organization_id       String    @db.Uuid
  params_hash           String                    /// SHA-256 of sorted JSON params
  /// Data
  cached_data           Json                      /// Full DataFetcherResult
  /// Timing
  fetched_at            DateTime  @default(now())
  expires_at            DateTime                  /// TTL-based expiration
  hit_count             Int       @default(0)     /// For cache optimization metrics

  @@unique([provider_key, organization_id, params_hash])
  @@index([expires_at])
  @@index([provider_key, organization_id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6E — Business Rules, Formula & Alert Engine
// ═══════════════════════════════════════════════════════════════════════════════

/// Formula Definition — metadata-driven calculation expression.
/// Supports arithmetic, aggregations, conditionals, provider references.
/// Expression syntax: SQL-like (SUM, AVG, IF, CASE, AND, OR, NOT).
model bre_formulas {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  /// Identity
  slug              String                    /// "spi_calculation", "safety_index"
  name              String                    /// "Schedule Performance Index"
  description       String?
  category          String                    /// planning | safety | execution | workforce | quality | management | custom
  /// Expression
  expression        String                    /// "earned_value / planned_value"
  variables         Json      @default("[]")  /// [{ name: "earned_value", provider_key: "planning.earned_value", field: "value" }]
  return_type       String    @default("number") /// number | percentage | text | boolean
  unit              String?                   /// "hrs", "%", "ratio", "index"
  precision         Int       @default(2)     /// Decimal places
  /// Validation
  is_validated      Boolean   @default(false)
  validation_errors Json?                     /// [{ message, position }]
  dependency_graph  Json?                     /// [{ from: "formula_a", to: "formula_b" }]
  /// Versioning
  version           Int       @default(1)
  /// State
  status            String    @default("draft") /// draft | active | deprecated | archived
  is_system         Boolean   @default(false) /// System formulas cannot be deleted
  /// Audit
  owner_id          String?   @db.Uuid
  created_by        String    @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  versions          bre_formula_versions[]
  kpi_definitions   bre_kpi_definitions[]

  @@unique([organization_id, slug])
  @@index([organization_id, category, status])
  @@index([status])
}

/// Formula Version — immutable snapshot of a formula expression at a point in time.
model bre_formula_versions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formula_id        String    @db.Uuid
  version_number    Int
  expression        String
  variables         Json      @default("[]")
  change_description String?
  /// Audit
  created_by        String    @db.Uuid
  created_at        DateTime  @default(now())
  /// Relations
  formula           bre_formulas @relation(fields: [formula_id], references: [id], onDelete: Cascade)

  @@unique([formula_id, version_number])
  @@index([formula_id])
}

/// KPI Definition — derived KPI built on a formula.
/// Auto-registers as a provider in ProviderRegistry.
model bre_kpi_definitions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  /// Identity
  slug              String                    /// "spi", "cpi", "trir"
  name              String                    /// "Schedule Performance Index"
  description       String?
  category          String                    /// planning | safety | execution | workforce | quality | management
  icon              String?                   /// Emoji or icon class
  /// Formula reference
  formula_id        String    @db.Uuid
  /// Thresholds (for coloring / alerting)
  threshold_green   Float?                    /// >= green = good
  threshold_amber   Float?                    /// >= amber = warning
  threshold_red     Float?                    /// < red = critical
  invert_thresholds Boolean   @default(false) /// true = lower is better (e.g., TRIR)
  /// Display
  target_value      Float?                    /// Target / benchmark
  display_format    String    @default("number") /// number | percentage | currency | duration | ratio
  trend_direction   String?                   /// up_good | down_good | neutral
  /// Provider registration
  provider_key      String                    /// "kpi.spi" — auto-registered in ProviderRegistry
  /// State
  status            String    @default("draft") /// draft | active | deprecated
  is_system         Boolean   @default(false)
  /// Audit
  owner_id          String?   @db.Uuid
  created_by        String    @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  formula           bre_formulas @relation(fields: [formula_id], references: [id])

  @@unique([organization_id, slug])
  @@unique([organization_id, provider_key])
  @@index([organization_id, category, status])
}

/// Business Rule — metadata-driven rule with condition expression and actions.
model bre_rules {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  /// Identity
  slug              String                    /// "critical_path_slip"
  name              String                    /// "Critical Path Slip Alert"
  description       String?
  category          String                    /// planning | execution | safety | qa_qc | inspection | management | notification | custom
  /// Condition
  condition_expression String                 /// "provider('planning.critical_activities').count > 0 AND SPI < 0.95"
  condition_variables  Json   @default("[]")  /// Variable bindings for the expression
  /// Evaluation
  evaluation_mode   String    @default("scheduled") /// scheduled | event_driven | both
  evaluation_cron   String?                   /// For scheduled: "*/15 * * * *"
  event_types       Json      @default("[]")  /// For event_driven: ["activity.updated", "workpack.completed"]
  /// Scope
  scope_site_id     String?   @db.Uuid
  scope_unit_id     String?   @db.Uuid
  scope_area        String?
  scope_equipment   String?
  scope_workpack_id String?   @db.Uuid
  scope_shift       String?
  /// Priority & Severity
  priority          Int       @default(5)     /// 1=highest, 10=lowest
  severity          String    @default("warning") /// information | warning | critical | emergency
  /// Effective dates
  effective_from    DateTime?
  effective_until   DateTime?
  /// Approval
  approval_status   String    @default("approved") /// draft | pending_approval | approved | rejected
  approved_by       String?   @db.Uuid
  approved_at       DateTime?
  /// State
  is_enabled        Boolean   @default(true)
  is_system         Boolean   @default(false)
  version           Int       @default(1)
  /// Escalation
  escalation_chain_id String? @db.Uuid
  /// Audit
  owner_id          String?   @db.Uuid
  created_by        String    @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  actions           bre_rule_actions[]
  alerts            bre_alerts[]
  escalation_chain  bre_escalation_chains? @relation(fields: [escalation_chain_id], references: [id])

  @@unique([organization_id, slug])
  @@index([organization_id, category, is_enabled])
  @@index([evaluation_mode, is_enabled])
  @@index([severity, is_enabled])
}

/// Rule Action — what happens when a rule condition evaluates to true.
model bre_rule_actions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id           String    @db.Uuid
  /// Action type
  action_type       String                    /// notify | escalate | create_alert | log | set_field | webhook
  /// Configuration (type-specific)
  config            Json      @default("{}")  /// { template_id, recipients, channel } for notify; { chain_id } for escalate
  /// Ordering
  sort_order        Int       @default(0)
  is_enabled        Boolean   @default(true)
  /// Relations
  rule              bre_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade)

  @@index([rule_id])
}

/// Alert Instance — active alert triggered by a rule evaluation.
model bre_alerts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  rule_id           String    @db.Uuid
  /// Alert identity
  alert_type        String                    /// threshold | trend | deviation | missing_data | late_activity | critical_path | schedule_health | resource | safety | permit | quality | execution | contractor | inspection | attendance | custom
  title             String                    /// "SPI dropped below 0.9"
  message           String                    /// Detailed alert message
  severity          String                    /// information | warning | critical | emergency
  priority          Int       @default(5)
  /// Context
  entity_type       String?                   /// activity | workpack | event | equipment | permit | contractor
  entity_id         String?   @db.Uuid
  scope_site_id     String?   @db.Uuid
  scope_unit_id     String?   @db.Uuid
  scope_area        String?
  /// Data snapshot
  trigger_value     String?                   /// The value that triggered the alert
  threshold_value   String?                   /// The threshold that was breached
  evaluation_data   Json?                     /// Full context data at trigger time
  /// Lifecycle
  status            String    @default("open") /// open | acknowledged | in_progress | resolved | closed | suppressed
  acknowledged_by   String?   @db.Uuid
  acknowledged_at   DateTime?
  resolved_by       String?   @db.Uuid
  resolved_at       DateTime?
  closed_by         String?   @db.Uuid
  closed_at         DateTime?
  assigned_to       String?   @db.Uuid
  resolution_notes  String?
  /// Escalation
  escalation_level  Int       @default(0)
  escalated_at      DateTime?
  /// AI
  ai_explanation    String?                   /// AI-generated root cause / recommendation
  /// Suppression
  suppress_until    DateTime?
  /// Audit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  rule              bre_rules @relation(fields: [rule_id], references: [id])
  comments          bre_alert_comments[]

  @@index([organization_id, status, severity])
  @@index([organization_id, alert_type])
  @@index([rule_id])
  @@index([assigned_to, status])
  @@index([created_at])
  @@index([severity, status])
}

/// Alert Comment — notes and discussion on an alert.
model bre_alert_comments {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_id          String    @db.Uuid
  comment           String
  comment_type      String    @default("note") /// note | status_change | escalation | assignment | resolution
  /// Audit
  created_by        String    @db.Uuid
  created_at        DateTime  @default(now())
  /// Relations
  alert             bre_alerts @relation(fields: [alert_id], references: [id], onDelete: Cascade)

  @@index([alert_id, created_at])
}

/// Escalation Chain — ordered list of escalation levels.
model bre_escalation_chains {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  /// Identity
  name              String                    /// "Planning Escalation Chain"
  description       String?
  category          String                    /// planning | safety | execution | management
  /// Config
  respect_business_hours Boolean @default(true)
  business_hours_start   String  @default("07:00") /// HH:mm
  business_hours_end     String  @default("18:00") /// HH:mm
  timezone               String  @default("UTC")
  holiday_calendar       Json?                 /// ["2026-12-25", "2026-01-01"]
  /// State
  is_active         Boolean   @default(true)
  /// Audit
  created_by        String    @db.Uuid
  updated_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Relations
  levels            bre_escalation_levels[]
  rules             bre_rules[]

  @@unique([organization_id, name])
  @@index([organization_id, is_active])
}

/// Escalation Level — one step in an escalation chain.
model bre_escalation_levels {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chain_id          String    @db.Uuid
  /// Level
  level_number      Int                       /// 1, 2, 3, ...
  name              String                    /// "Planning Lead", "Shutdown Manager"
  /// Timing
  escalate_after_minutes Int  @default(60)    /// Minutes before escalating to next level
  /// Recipients
  recipient_type    String                    /// user | role | group | email
  recipient_value   String                    /// userId | "planning_lead" | groupId | "mgr@co.com"
  /// Notification
  notification_channel String @default("email") /// email | sms | in_app | teams | slack
  notification_template_id String? @db.Uuid
  /// Relations
  chain             bre_escalation_chains @relation(fields: [chain_id], references: [id], onDelete: Cascade)

  @@unique([chain_id, level_number])
  @@index([chain_id])
}

/// Evaluation Log — audit trail for rule and formula evaluations.
model bre_evaluation_log {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  /// What was evaluated
  evaluation_type   String                    /// formula | rule | kpi
  target_id         String    @db.Uuid        /// formula_id | rule_id | kpi_id
  target_slug       String                    /// For quick lookup
  /// Result
  result_value      String?                   /// Computed value (stringified)
  result_passed     Boolean?                  /// For rules: did condition pass?
  /// Performance
  duration_ms       Int?
  /// Context
  input_params      Json?                     /// Parameters used for evaluation
  error_message     String?
  /// Alert linkage
  alert_id          String?   @db.Uuid
  /// Audit
  evaluated_by      String?   @db.Uuid        /// null = system/scheduled
  evaluated_at      DateTime  @default(now())

  @@index([organization_id, evaluation_type, evaluated_at])
  @@index([target_id])
  @@index([evaluated_at])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6F — Decision Recommendation Engine
// ═══════════════════════════════════════════════════════════════════════════════

/// Decision Recommendations — AI/rule-generated suggestions for planners and managers.
/// Recommendations NEVER execute automatically. Always require human acceptance.
model bre_recommendations {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  /// Identification
  slug                String
  title               String
  description         String
  category            String                    /// planning | safety | execution | qa_qc | inspection | contractor | resource | material | permit | critical_path | constraint
  priority            String    @default("medium")  /// low | medium | high | critical
  /// Confidence & Reasoning
  confidence_score    Decimal   @db.Decimal(5, 4)   /// 0.0000 - 1.0000
  reasoning           String                    /// Why this recommendation was generated
  expected_impact     String?                   /// What happens if accepted
  /// Source
  source_type         String    @default("rule")    /// rule | formula | kpi | ai | manual
  source_rule_id      String?   @db.Uuid            /// Rule that triggered this recommendation
  source_formula_id   String?   @db.Uuid            /// Formula that computed the threshold
  /// Supporting Data
  supporting_kpis     Json?                     /// [{ name, value, threshold }]
  supporting_rules    Json?                     /// [{ ruleId, name, result }]
  related_alert_ids   Json?                     /// [alertId, ...]
  alternatives        Json?                     /// [{ title, description, confidence }]
  /// Lifecycle
  status              String    @default("pending") /// pending | presented | accepted | rejected | deferred | expired | superseded
  accepted_by         String?   @db.Uuid
  accepted_at         DateTime?
  rejected_by         String?   @db.Uuid
  rejected_at         DateTime?
  rejection_reason    String?
  deferred_until      DateTime?
  expires_at          DateTime?
  /// Scope
  target_entity_type  String?                   /// workpack | activity | event | permit | crew
  target_entity_id    String?   @db.Uuid
  event_id            String?   @db.Uuid
  /// Visibility
  show_in_dashboard   Boolean   @default(true)
  show_in_tv_mode     Boolean   @default(false)
  show_in_meeting     Boolean   @default(true)
  show_in_reports     Boolean   @default(true)
  /// Audit
  created_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  organization        Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  logs                bre_recommendation_log[]

  @@index([organization_id, status, category])
  @@index([organization_id, priority, status])
  @@index([status, expires_at])
  @@index([event_id])
  @@index([target_entity_type, target_entity_id])
}

/// Recommendation Audit Log — records every state transition and user interaction.
model bre_recommendation_log {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id   String    @db.Uuid
  /// Action
  action              String                    /// created | presented | accepted | rejected | deferred | expired | superseded | comment
  /// Actor
  performed_by        String?   @db.Uuid
  performed_at        DateTime  @default(now())
  /// Details
  comment             String?
  previous_status     String?
  new_status          String?
  metadata            Json?

  recommendation      bre_recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)

  @@index([recommendation_id, performed_at])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6G — Beta Platform, Licensing & Operational Readiness
// ═══════════════════════════════════════════════════════════════════════════════

/// Enterprise License — exactly one per organization.
/// Controls feature access, user limits, and resource quotas.
model platform_licenses {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String    @unique @db.Uuid
  license_number          String    @unique                   /// SYO-XXXX-XXXX format
  license_type            String    @default("trial")         /// trial | beta | starter | professional | enterprise | unlimited | custom
  status                  String    @default("active")        /// active | suspended | expired | revoked | grace
  /// Dates
  issued_at               DateTime  @default(now())
  expires_at              DateTime?
  grace_period_days       Int       @default(14)
  /// Resource Limits
  max_users               Int       @default(15)
  max_shutdowns           Int       @default(5)
  max_projects            Int       @default(10)
  max_storage_gb          Int       @default(10)
  max_documents           Int       @default(500)
  max_reports             Int       @default(100)
  max_dashboards          Int       @default(20)
  max_scheduled_reports   Int       @default(10)
  max_ai_credits          Int       @default(1000)
  max_api_calls_daily     Int       @default(10000)
  max_bg_jobs_daily       Int       @default(500)
  max_emails_monthly      Int       @default(1000)
  /// Metadata
  notes                   String?
  created_by              String?   @db.Uuid
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  organization            Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([license_type, status])
  @@index([expires_at])
}

/// Module Definitions — catalog of all platform modules.
model platform_modules {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String    @unique                         /// digital_plant | asset_register | planner_workspace | etc.
  name              String                                    /// Display name
  description       String?
  category          String    @default("core")                /// core | planning | intelligence | safety | execution | future
  icon              String?                                   /// Emoji or icon key
  sort_order        Int       @default(0)
  is_core           Boolean   @default(false)                 /// Core modules cannot be disabled
  default_status    String    @default("enabled")             /// Default for new orgs
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  organization_modules organization_modules[]
}

/// Per-Organization Module Status.
model organization_modules {
  organization_id   String    @db.Uuid
  module_id         String    @db.Uuid
  status            String    @default("enabled")             /// enabled | disabled | hidden | beta | coming_soon | experimental
  enabled_at        DateTime  @default(now())
  enabled_by        String?   @db.Uuid
  updated_at        DateTime  @updatedAt

  organization      Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  module            platform_modules @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@id([organization_id, module_id])
  @@index([organization_id])
}

/// Usage Tracking — consumption metrics per organization per period.
model platform_usage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  metric_key        String                                    /// ai_tokens | emails | reports | dashboards | storage_mb | documents | api_calls | bg_jobs | provider_calls
  period            String    @default("daily")               /// daily | monthly
  period_date       DateTime  @db.Timestamptz(3)                        /// Date for this period
  value             Int       @default(0)                     /// Consumed amount
  limit_value       Int?                                      /// License limit at time of recording
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([organization_id, metric_key, period, period_date])
  @@index([organization_id, metric_key, period_date])
  @@index([period_date])
}

/// Beta Feedback — user-submitted feedback with auto-captured environment.
model platform_feedback {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String    @db.Uuid
  user_id           String    @db.Uuid
  /// Content
  type              String    @default("general")             /// bug | improvement | feature_request | question | general
  title             String
  description       String
  severity          String    @default("medium")              /// low | medium | high | critical
  /// Auto-captured Context
  app_version       String?
  git_commit        String?
  route             String?
  current_module    String?
  browser           String?
  os                String?
  resolution        String?
  /// Attachments
  screenshot_url    String?
  /// Lifecycle
  status            String    @default("open")                /// open | acknowledged | in_progress | resolved | closed | wont_fix
  assigned_to       String?   @db.Uuid
  resolution_notes  String?
  resolved_at       DateTime?
  /// Audit
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([organization_id, status])
  @@index([type, status])
  @@index([severity, status])
  @@index([created_at])
}

// ═══════════════════════════════════════════════════════════════════════════════
// M7.6G.1 — Beta Readiness Pack
// ═══════════════════════════════════════════════════════════════════════════════

/// Seed Pack definitions — reusable packages that provision organizations with demo data
model seed_packs {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String    @unique
  name                   String
  description            String?
  category               String    @default("demo")           /// demo | training | pilot | internal | custom
  version                String    @default("1.0.0")
  status                 String    @default("ready")          /// draft | ready | archived
  /// Full configuration JSON: org, hierarchy, users, roles, events, issues, scope, workpacks, etc.
  config                 Json      @default("{}")
  /// Estimates
  estimated_records      Int       @default(0)
  estimated_time_seconds Int       @default(60)
  /// Built-in packs are protected from deletion
  is_builtin             Boolean   @default(false)
  /// Audit
  created_by             String?   @db.Uuid
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  executions             seed_pack_executions[]

  @@index([category, status])
}

/// Seed Pack execution log
model seed_pack_executions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seed_pack_id      String    @db.Uuid
  organization_id   String?   @db.Uuid
  /// Status
  status            String    @default("pending")             /// pending | running | completed | failed | rolled_back
  /// Stats
  records_created   Int       @default(0)
  error_message     String?
  execution_log     Json      @default("[]")
  /// Timestamps
  started_at        DateTime  @default(now())
  completed_at      DateTime?
  /// Relations
  seed_pack         seed_packs @relation(fields: [seed_pack_id], references: [id], onDelete: Cascade)

  @@index([seed_pack_id])
  @@index([organization_id])
  @@index([status])
}

/// Platform backup records
model platform_backups {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  type              String    @default("full")                /// full | incremental | config_only | data_only | documents_only
  status            String    @default("pending")             /// pending | running | completed | failed | expired
  /// File info
  file_path         String?
  file_size_bytes   BigInt    @default(0)
  checksum          String?                                   /// SHA-256
  /// What's included
  scope             Json      @default("{}")
  /// Options
  compression       String    @default("gzip")                /// none | gzip
  encrypted         Boolean   @default(false)
  /// Timestamps
  started_at        DateTime  @default(now())
  completed_at      DateTime?
  expires_at        DateTime?
  /// Audit
  created_by        String?   @db.Uuid
  notes             String?

  restores          platform_restores[]

  @@index([status])
  @@index([type])
  @@index([started_at])
}

/// Platform restore history
model platform_restores {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backup_id         String    @db.Uuid
  type              String    @default("full")                /// full | partial | preview
  status            String    @default("pending")             /// pending | running | completed | failed
  /// What was restored
  scope             Json      @default("{}")
  records_restored  Int       @default(0)
  error_message     String?
  /// Timestamps
  started_at        DateTime  @default(now())
  completed_at      DateTime?
  /// Audit
  created_by        String?   @db.Uuid

  backup            platform_backups @relation(fields: [backup_id], references: [id], onDelete: Cascade)

  @@index([backup_id])
  @@index([status])
}

/// ──────────────────────────────────────────────────────────────────────────────
/// M8.10 — Enterprise EVM & Cost Intelligence
/// ──────────────────────────────────────────────────────────────────────────────

model EvmSnapshot {
  id              String   @id @db.Uuid
  organization_id String   @db.Uuid
  event_id        String   @db.Uuid
  /// OD9.1: microsecond precision and the JSONB defaults below are what the table
  /// physically has. Declared as-is so no conversion is proposed outside R1.0-C2.
  snapshot_date   DateTime @db.Timestamp(6)
  snapshot_type   String   /// 'daily' | 'manual' | 'baseline_change'
  curve_data      Json     @default("{}") /// { dates: string[], pv: number[], ev: number[], ac: number[] }
  summary         Json     @default("{}") /// { bac, pv, ev, ac, cv, sv, cpi, spi, eac, etc, vac, tcpi }
  created_at      DateTime @default(now()) @db.Timestamp(6)

  @@index([event_id, snapshot_date])
  @@index([organization_id])
}

/// ──────────────────────────────────────────────────────────────────────────────
/// M8.11 — Enterprise Scope Change & Discovery Work Workflow
/// ──────────────────────────────────────────────────────────────────────────────

/// Formalize the existing schedule_change_requests table (created in M8.8 migration).
model ScheduleChangeRequest {
  id                   String    @id @db.Uuid
  organization_id      String    @db.Uuid
  event_id             String    @db.Uuid
  change_type          String
  title                String
  description          String?
  scenario_id          String?   @db.Uuid
  simulation_data      Json?
  activities_affected  Int       @default(0)
  float_consumed       Float?    @default(0)
  project_finish_delta Float?    @default(0)
  constraints_resolved Int       @default(0)
  status               String    @default("proposed")
  submitted_by         String    @db.Uuid
  submitted_at         DateTime  @default(now())
  reviewed_by          String?   @db.Uuid
  reviewed_at          DateTime?
  review_notes         String?
  applied_at           DateTime?
  applied_by           String?   @db.Uuid
  source_scenario_id   String?            @db.Uuid
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  scenario             ScheduleScenario?  @relation("ChangeRequestScenario", fields: [scenario_id], references: [id], onDelete: SetNull)
  sourceScenario       ScheduleScenario?  @relation("ChangeRequestSourceScenario", fields: [source_scenario_id], references: [id], onDelete: SetNull)
  /// OD9.1: the event foreign key exists physically but was undeclared, so `migrate diff`
  /// proposed dropping it. R0.4 requires change requests to stay bound to their Event.
  event                Event              @relation(fields: [event_id], references: [id])

  @@index([event_id, status])
  @@index([organization_id])
  @@map("schedule_change_requests")
}

/// M8.8/M8.9 — Schedule Scenario for what-if analysis
model ScheduleScenario {
  id                    String                    @id @db.Uuid
  organization_id       String                    @db.Uuid
  event_id              String                    @db.Uuid
  name                  String
  description           String?
  source_type           String                    @default("leveling")
  snapshot_json         Json
  activities_affected   Int                       @default(0)
  float_consumed        Float?                    @default(0)
  project_finish_delta  Float?                    @default(0)
  constraints_resolved  Int                       @default(0)
  status                String                    @default("draft")
  base_baseline_id      String?                   @db.Uuid
  created_by            String                    @db.Uuid
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  event                 Event                     @relation(fields: [event_id], references: [id], onDelete: Restrict)
  baseBaseline          ScheduleBaseline?         @relation(fields: [base_baseline_id], references: [id], onDelete: SetNull)
  overrides             ScenarioActivityOverride[]
  changeRequests        ScheduleChangeRequest[]   @relation("ChangeRequestScenario")
  sourceChangeRequests  ScheduleChangeRequest[]   @relation("ChangeRequestSourceScenario")

  @@index([event_id, status])
  @@index([organization_id])
  @@map("schedule_scenarios")
}

/// M8.9 — Activity overrides within a scenario (what-if adjustments)
model ScenarioActivityOverride {
  id                     String            @id @db.Uuid
  scenario_id            String            @db.Uuid
  activity_id            String            @db.Uuid
  duration_hours         Decimal?          @db.Decimal(8, 2)
  planned_start          DateTime?         @db.Timestamptz(3)
  planned_end            DateTime?         @db.Timestamptz(3)
  is_active              Boolean           @default(true)
  early_start_constraint DateTime?
  scenario               ScheduleScenario  @relation(fields: [scenario_id], references: [id], onDelete: Cascade)
  activity               Activity          @relation(fields: [activity_id], references: [id], onDelete: Restrict)

  @@unique([scenario_id, activity_id])
}

/// Discovery record — newly found work during turnaround execution.
model DiscoveryWork {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String    @db.Uuid
  event_id         String    @db.Uuid
  title            String
  description      String?
  discovery_type   String    @default("field_discovery")
  /// Types: field_discovery, inspection_finding, emergency, opportunity, engineering_change, regulatory
  source           String?
  location         String?
  asset_id         String?   @db.Uuid
  discipline       String?
  priority         String    @default("medium")
  estimated_hours  Int       @default(0)
  estimated_cost   Float     @default(0)
  attachments      Json      @default("[]")
  status           String    @default("discovered")
  /// Lifecycle: discovered → assessed → converted → closed / rejected
  assessed_by      String?   @db.Uuid
  assessed_at      DateTime?
  assessment_notes String?
  scope_change_id  String?   @db.Uuid
  discovered_by    String    @db.Uuid
  discovered_at    DateTime  @default(now())
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  event            Event          @relation(fields: [event_id], references: [id])
  organization     Organization   @relation(fields: [organization_id], references: [id])
  scopeChanges     ScheduleScopeChange[]

  @@index([event_id, status])
  @@index([organization_id])
  @@map("discovery_work")
}

/// Scope change proposal — bridges discovery with schedule change control.
model ScheduleScopeChange {
  id                     String    @id @default(uuid()) @db.Uuid
  organization_id        String    @db.Uuid
  event_id               String    @db.Uuid
  discovery_id           String?   @db.Uuid
  change_number          String
  title                  String
  description            String?
  change_category        String    @default("scope_addition")
  /// Categories: scope_addition, scope_removal, scope_modification, activity_addition, duration_change, resource_change
  justification          String?
  status                 String    @default("draft")
  /// Lifecycle: draft → analyzing → proposed → approved → applying → applied / rejected
  priority               String    @default("medium")
  discipline             String?
  schedule_impact_days   Float     @default(0)
  cost_impact            Float     @default(0)
  resource_impact_hours  Float     @default(0)
  critical_path_affected Boolean   @default(false)
  impact_analysis        Json      @default("{}")
  submitted_by           String?   @db.Uuid
  submitted_at           DateTime?
  reviewed_by            String?   @db.Uuid
  reviewed_at            DateTime?
  review_notes           String?
  approved_by            String?   @db.Uuid
  approved_at            DateTime?
  applied_at             DateTime?
  applied_by             String?   @db.Uuid
  change_request_id      String?   @db.Uuid
  result_workpack_id     String?   @db.Uuid
  result_summary         Json      @default("{}")
  created_by             String    @db.Uuid
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  items                  ScheduleScopeChangeItem[]
  event                  Event          @relation(fields: [event_id], references: [id])
  organization           Organization   @relation(fields: [organization_id], references: [id])
  discovery              DiscoveryWork? @relation(fields: [discovery_id], references: [id])

  @@unique([organization_id, change_number])
  @@index([event_id, status])
  @@index([organization_id])
  @@map("schedule_scope_changes")
}

/// Individual line item within a scope change proposal.
model ScheduleScopeChangeItem {
  id              String    @id @default(uuid()) @db.Uuid
  scope_change_id String    @db.Uuid
  item_type       String    @default("new_activity")
  /// Types: new_activity, new_workpack, modify_activity, remove_activity
  description     String
  workpack_id     String?   @db.Uuid
  activity_id     String?   @db.Uuid
  discipline      String?
  estimated_hours Float     @default(0)
  estimated_cost  Float     @default(0)
  resource_type   String?
  crew_size       Int       @default(1)
  planned_start   DateTime? @db.Timestamptz(3)
  planned_end     DateTime? @db.Timestamptz(3)
  predecessor_ids String[]  @default([]) @db.Uuid
  notes           String?
  sort_order      Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  scopeChange     ScheduleScopeChange @relation(fields: [scope_change_id], references: [id], onDelete: Cascade)

  @@index([scope_change_id])
  @@map("schedule_scope_change_items")
}

/// M8.12 — Material Supply Record: tracks PO/delivery per material line.
model MaterialSupplyRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  organization_id     String    @db.Uuid
  material_line_id    String    @db.Uuid
  supplier_name       String?
  po_number           String?
  po_line_number      String?
  quantity_ordered    Float     @default(0)
  quantity_received   Float     @default(0)
  expected_delivery   DateTime? @db.Timestamptz(3)
  actual_delivery     DateTime? @db.Timestamptz(3)
  delivery_status     String    @default("pending")
  /// Status: pending, confirmed, in_transit, partial, received, delayed, cancelled
  unit_cost           Float?
  total_cost          Float?
  notes               String?
  created_by          String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  materialLine        workpack_material_lines @relation(fields: [material_line_id], references: [id])
  organization        Organization @relation(fields: [organization_id], references: [id])

  @@index([material_line_id])
  @@index([organization_id])
  @@index([delivery_status])
  @@map("material_supply_records")
}

/// M8.12 — Material Constraint: computed record linking material readiness to activity scheduling.
model MaterialConstraint {
  id                    String    @id @default(uuid()) @db.Uuid
  organization_id       String    @db.Uuid
  event_id              String    @db.Uuid
  activity_id           String    @db.Uuid
  workpack_id           String?   @db.Uuid
  material_line_id      String?   @db.Uuid
  constraint_type       String    @default("material_eta")
  /// Types: material_eta, material_shortage, material_critical
  constraint_date       DateTime? @db.Timestamptz(3)
  readiness_status      String    @default("not_ready")
  /// Status: ready, partial, not_ready, at_risk, blocked
  readiness_percent     Float     @default(0)
  quantity_required     Float     @default(0)
  quantity_available    Float     @default(0)
  quantity_on_order     Float     @default(0)
  earliest_eta          DateTime? @db.Timestamptz(3)
  is_binding            Boolean   @default(false)
  is_critical_material  Boolean   @default(false)
  impact_days           Float     @default(0)
  last_calculated_at    DateTime  @default(now())
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  activity              Activity     @relation(fields: [activity_id], references: [id])
  event                 Event        @relation(fields: [event_id], references: [id])
  organization          Organization @relation(fields: [organization_id], references: [id])

  @@unique([activity_id, material_line_id])
  @@index([event_id, readiness_status])
  @@index([activity_id])
  @@index([organization_id])
  @@map("material_constraints")
}

// ═══════════════════════════════════════════════════════════════════════════════
// M8.13 — Enterprise Turnaround Progress Intelligence
// ═══════════════════════════════════════════════════════════════════════════════

/// Standard Activity Type — canonical activity types for a given equipment type.
/// e.g., "Blinding", "Bundle Pullout", "Inspection" for Heat Exchangers.
/// Enables identical-activity analysis across the turnaround scope.
model StandardActivityType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String?  @db.Uuid  /// null = platform-level
  equipment_type_id   String             /// FK to EquipmentType.id (String, not UUID)
  name                String             /// "Blinding", "Bundle Pullout", "Inspection"
  code                String             /// "BLIND", "BPULL", "INSP"
  description         String?
  is_mandatory        Boolean  @default(true)  /// Is this activity always required for the equipment type?
  typical_duration_hrs Float?   /// Typical duration for planning reference
  sort_order          Int      @default(0)
  is_active           Boolean  @default(true)
  /// OD9.1: these two columns are timestamptz in the database, unlike the rest of the
  /// schema. Declared as-is so no conversion is proposed outside R1.0-C2.
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  equipment_type      EquipmentType @relation(fields: [equipment_type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// Activities classified as this standard type
  activities          Activity[]

  @@unique([equipment_type_id, code], name: "sat_equip_code", map: "sat_equip_code")
  @@index([organization_id, equipment_type_id])
  @@map("standard_activity_types")
}

// ═══════════════════════════════════════════════════════════════════════════════
// M8.14-R1 — Asset Attribute EAV Models (P0-1 fix)
// ═══════════════════════════════════════════════════════════════════════════════

/// Attribute definition — defines what attributes exist per equipment type.
/// organization_id = null means PLATFORM scope (shared across all tenants).
model AssetAttributeDefinition {
  id                String    @id @default(uuid()) @db.Uuid
  /// null = PLATFORM scope, non-null = TENANT scope
  organization_id   String?   @db.Uuid
  code              String
  name              String
  description       String?
  /// string | number | boolean | date | select
  data_type         String
  unit              String?
  /// Empty array = applies to all equipment types
  equipment_types   String[]  @default([])
  group_name        String?
  group_sort_order  Int       @default(0)
  sort_order        Int       @default(0)
  is_required       Boolean   @default(false)
  is_design_basis   Boolean   @default(false)
  is_active         Boolean   @default(true)
  validation_rule   Json?
  select_options    Json?
  /// PLATFORM or TENANT
  scope             String    @default("PLATFORM")
  created_by        String?   @db.Uuid
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  values            AssetAttributeValue[]
  history           AssetAttributeHistory[]

  @@unique([organization_id, code], name: "attr_def_org_code")
  @@index([organization_id, is_active])
  @@map("asset_attribute_definitions")
}

/// Current attribute value — one row per (asset, definition) pair.
/// This is the "live" value; history is append-only in AssetAttributeHistory.
model AssetAttributeValue {
  id                  String    @id @default(uuid()) @db.Uuid
  organization_id     String    @db.Uuid
  asset_id            String    @db.Uuid
  definition_id       String    @db.Uuid
  value_string        String?
  value_number        Float?
  value_boolean       Boolean?
  value_date          DateTime? @db.Timestamptz(3)
  /// manual | ai_extraction | excel_import | p_and_id
  source_type         String    @default("manual")
  source_document_id  String?   @db.Uuid
  source_doc_revision String?
  source_page         Int?
  source_region       String?
  ai_model            String?
  ai_confidence       Float?
  extraction_job_id   String?   @db.Uuid
  /// unverified | ai_candidate | verified
  status              String    @default("unverified")
  entered_by          String?   @db.Uuid
  /// OD9.1: when this value was first entered. Populated on every row with a distinct
  /// timestamp that exists nowhere else — it cannot be reconstructed if dropped.
  entered_at          DateTime  @default(now())
  verified_by         String?   @db.Uuid
  verified_at         DateTime?
  verification_notes  String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  definition          AssetAttributeDefinition @relation(fields: [definition_id], references: [id])
  asset               Asset                    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  history             AssetAttributeHistory[]

  @@unique([asset_id, definition_id], name: "asset_attr_unique", map: "asset_attr_unique")
  @@unique([asset_id, definition_id], map: "asset_attribute_values_asset_id_definition_id_key")
  @@index([organization_id, asset_id])
  @@index([asset_id, status])
  @@index([definition_id])
  @@map("asset_attribute_values")
}

/// Append-only attribute history — R2.1 INVARIANT: rows are NEVER updated or deleted.
/// Every event (AI extraction, planner decision, manual entry, verification,
/// superseded) is a separate immutable row.
model AssetAttributeHistory {
  id                    String    @id @default(uuid()) @db.Uuid
  organization_id       String    @db.Uuid
  asset_id              String    @db.Uuid
  definition_id         String    @db.Uuid
  value_id              String?   @db.Uuid
  value_string          String?
  value_number          Float?
  value_boolean         Boolean?
  value_date            DateTime? @db.Timestamptz(3)
  source_type           String
  source_document_id    String?   @db.Uuid
  source_doc_revision   String?
  source_page           Int?
  source_region         String?
  ai_model              String?
  ai_confidence         Float?
  extraction_job_id     String?   @db.Uuid
  /// ai_extracted | ai_accepted | ai_modified | ai_rejected | manual_entered | verified | superseded
  action                String
  /// unverified | ai_candidate | verified
  status_at_time        String
  /// Links decision rows to the original AI extraction row
  refers_to_history_id  String?   @db.Uuid
  performed_by          String    @db.Uuid
  performed_at          DateTime  @default(now())
  reason                String?
  /// OD9.1: row insertion time, distinct from performed_at. Populated on every row with
  /// a distinct timestamp that exists nowhere else — it cannot be reconstructed.
  created_at            DateTime  @default(now())

  definition            AssetAttributeDefinition @relation(fields: [definition_id], references: [id])
  value                 AssetAttributeValue?     @relation(fields: [value_id], references: [id])
  asset                 Asset                    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  /// OD9.1: R2.1 provenance chain — links a decision row to the AI extraction it acted on.
  /// The database carries two identical FKs on this column; Prisma can declare only one,
  /// so the redundant duplicate is dropped. Enforcement is unchanged — see OD9-034.
  refers_to             AssetAttributeHistory?   @relation("AssetAttributeHistoryRefersTo", fields: [refers_to_history_id], references: [id], onDelete: Restrict, map: "asset_attribute_history_refers_to_fkey")
  referred_by           AssetAttributeHistory[]  @relation("AssetAttributeHistoryRefersTo")

  @@index([asset_id, definition_id])
  @@index([organization_id, asset_id])
  @@index([refers_to_history_id])
  @@index([asset_id, definition_id, performed_at])
  @@index([asset_id, performed_at])
  @@index([organization_id, performed_at])
  @@map("asset_attribute_history")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OD9.1 — LIVE TABLES PREVIOUSLY MISSING FROM THIS SCHEMA
//
// Every model below already exists physically in the database and is read or
// written by shipped application code. They were absent from schema.prisma, so
// `prisma migrate diff` proposed DROP TABLE for each one. The definitions are
// transcribed from the live PostgreSQL catalogue (`prisma db pull` against
// syority), not authored fresh: column types, nullability, defaults, primary
// keys, unique constraints, indexes and foreign-key actions all mirror what is
// physically present. See docs/AURIANOA_R1.0_OD9_1_IMPLEMENTATION_RESULT.md §6.
// ═══════════════════════════════════════════════════════════════════════════════

/// M8.6 — asset-to-asset / asset-to-line connectivity used by the asset register.
/// DDL origin: prisma/migrations/add_asset_register_m86.sql (never a Prisma migration).
model asset_relationships {
  id                String   @id @db.Uuid
  organization_id   String   @db.Uuid
  source_asset_id   String   @db.Uuid
  target_asset_id   String?  @db.Uuid
  target_line_id    String?  @db.Uuid
  relationship_type String
  description       String?
  nozzle_id         String?  @db.Uuid
  is_active         Boolean  @default(true)
  created_by        String?  @db.Uuid
  created_at        DateTime @default(now())
  updated_at        DateTime
  source_asset      Asset    @relation("asset_relationships_source_asset_idToAsset", fields: [source_asset_id], references: [id])
  target_asset      Asset?   @relation("asset_relationships_target_asset_idToAsset", fields: [target_asset_id], references: [id])

  @@unique([source_asset_id, target_asset_id, relationship_type])
  @@index([source_asset_id])
  @@index([target_asset_id])
}

/// M8.6 — immutable point-in-time copy of an asset taken when it is attached to a
/// workpack. DDL origin: prisma/migrations/add_asset_register_m86.sql. There is no
/// Prisma migration for this table; the definition below is the physical catalogue.
model workpack_asset_snapshots {
  id                String   @id @db.Uuid
  workpack_id       String   @db.Uuid
  asset_id          String   @db.Uuid
  snapshot_revision String
  asset_data_json   Json
  attributes_json   Json
  nozzles_json      Json?
  lines_json        Json?
  documents_json    Json?
  snapshotted_by    String   @db.Uuid
  snapshotted_at    DateTime @default(now())
  asset             Asset    @relation(fields: [asset_id], references: [id])
  workpack          Workpack @relation(fields: [workpack_id], references: [id])

  @@unique([workpack_id, snapshot_revision])
  @@index([workpack_id])
}

/// Enterprise provisioning — tenant onboarding request captured by the public form.
model onboarding_requests {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName   String
  contactName   String
  contactEmail  String
  contactPhone  String?
  industry      String?
  country       String?
  employeeCount String?
  notes         String?
  status        String    @default("PENDING")
  reviewedBy    String?   @db.Uuid
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime

  @@index([createdAt])
  @@index([status])
}

/// Enterprise provisioning — reusable tenant blueprint.
model provisioning_templates {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String              @unique
  name              String
  industry          String?
  description       String?
  is_builtin        Boolean             @default(false)
  config            Json                @default("{}")
  created_by        String?             @db.Uuid
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  jobs              provisioning_jobs[]

  @@index([industry])
  @@index([is_builtin])
}

/// Enterprise provisioning — one tenant build, executed by ProvisioningWorker.
model provisioning_jobs {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String?                 @db.Uuid
  template_id            String?                 @db.Uuid
  request                Json                    @default("{}")
  status                 String                  @default("queued")
  current_step           String?
  completed_steps        Json                    @default("[]")
  failed_step            String?
  error                  String?
  stack_trace            String?
  progress_pct           Int                     @default(0)
  retries                Int                     @default(0)
  max_retries            Int                     @default(3)
  duration_ms            Int?
  started_at             DateTime?
  completed_at           DateTime?
  cancelled_at           DateTime?
  created_by             String                  @db.Uuid
  created_at             DateTime                @default(now())
  /// Field names below match ProvisioningJobService's include shape.
  logs                   provisioning_job_logs[]
  organization           Organization?           @relation(fields: [organization_id], references: [id])
  template               provisioning_templates? @relation(fields: [template_id], references: [id])

  @@index([created_by])
  @@index([organization_id])
  @@index([status])
}

/// Enterprise provisioning — per-step audit trail for a provisioning job.
model provisioning_job_logs {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id      String            @db.Uuid
  step        String
  status      String            @default("running")
  message     String?
  metadata    Json?             @default("{}")
  duration_ms Int?
  created_at  DateTime          @default(now())
  job         provisioning_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id])
  @@index([step])
}
