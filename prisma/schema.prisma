  project            Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organization_id], references: [id])
  parent             WbsNode?     @relation("WbsNodeToWbsNode", fields: [parent_id], references: [id])
  children           WbsNode[]    @relation("WbsNodeToWbsNode")
  system             System?      @relation(fields: [system_id], references: [id])
  workpacks          Workpack[]

  @@index([organization_id, event_id])
  @@index([organization_id, project_id])
  @@index([parent_id])
  @@index([system_id])
  @@map("wbs_nodes")
}

