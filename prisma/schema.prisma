generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id                         String                 @id @db.Uuid
  organization_id            String                 @db.Uuid
  site_id                    String                 @db.Uuid
  workpack_id                String?                @db.Uuid
  event_id                   String?                @db.Uuid
  activity_library_id        String?                @db.Uuid
  sequence_number            Int?                   @default(0)
  activity_number            String?
  activity_id                String?
  description                String
  responsible                String?
  work_category              String?
  discipline_id              String?                @db.Uuid
  duration_hours             Decimal?               @default(0) @db.Decimal(8, 2)
  window                     String?
  planned_start              DateTime?              @db.Timestamptz(3)
  planned_end                DateTime?              @db.Timestamptz(3)
  actual_start               DateTime?              @db.Timestamptz(3)
  actual_end                 DateTime?              @db.Timestamptz(3)
  /// Sprint 1b — planned dates are CPM-derived (M11). planned_* is the
  /// EFFECTIVE value: the CPM derivation, or the planner's audited override
  /// when one is active. planned_derived_* preserves the CPM value.
  planned_start_override     DateTime?              @db.Timestamptz(3)
  planned_end_override       DateTime?              @db.Timestamptz(3)
  planned_derived_start      DateTime?              @db.Timestamptz(3)
  planned_derived_end        DateTime?              @db.Timestamptz(3)
  planned_override_reason    String?
  planned_override_by        String?                @db.Uuid
  planned_override_at        DateTime?              @db.Timestamptz(3)
  progress_percent           Int?                   @default(0)
  status                     ActivityStatus?        @default(not_started)
  notes                      String?
  is_optional                Boolean                @default(false)
  color_label                String?
  hold_point_type            String?
  hold_point_description     String?
  p6_object_id               Int?
  p6_activity_id             String?
  is_approved_for_scheduling Boolean?               @default(false)
  early_start                DateTime?
  early_finish               DateTime?
  late_start                 DateTime?
  late_finish                DateTime?
  /// CPM total float in HOURS (canonical). UI converts to days via ScheduleCalendar.hours_per_day.
  total_float                Decimal?               @db.Decimal(12, 2)
  is_critical                Boolean?               @default(false)
  manpower_count             Int?
  manpower_type              String?
  wbs_code                   String?
  free_float                 Float?
  budgeted_cost              Float?
  actual_cost                Float?
  remaining_duration         Float?
  /// Provenance: 'workpack' (native) | 'imported' (legacy P6/MPP) | null.
  /// Created physically by OD9.1 (20260910000000_od91_activity_schedule_source); required
  /// by the R1.0-C1 Time Authority Contract to distinguish planner-authored dates from
  /// imported ones. Written on every path by ActivityCreationCommand.
  schedule_source            String?
  created_by                 String?                @db.Uuid
  updated_by                 String?                @db.Uuid
  created_at                 DateTime               @default(now())
  updated_at                 DateTime               @updatedAt
  deleted_at                 DateTime?
  workpack                   Workpack?              @relation(fields: [workpack_id], references: [id])
  organization               Organization           @relation(fields: [organization_id], references: [id])
  site                       Site                   @relation(fields: [site_id], references: [id])
  discipline                 Discipline?            @relation(fields: [discipline_id], references: [id])
  resources                  ActivityResource[]
  udf_values                 ActivityUdfValue[]
  qa_clearance_records       qa_clearance_records[]
  ProgressLog                ProgressLog[]
  predecessors               ActivityRelationship[] @relation("activity_as_successor")
  successors                 ActivityRelationship[] @relation("activity_as_predecessor")
  /// M8.12 — Material Constraints
  material_constraints       MaterialConstraint[]
  /// M8.13 — Standard Activity Classification
  standard_activity_type_id  String?                @db.Uuid
  standard_activity_type     StandardActivityType?  @relation(fields: [standard_activity_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// M8.9 — Scenario overrides
  scenarioOverrides          ScenarioActivityOverride[]
  /// OD9.1 — live FK from Permit.activity_id
  permits                    Permit[]
  /// R0.4 / OD9.1 — the Event this activity belongs to. The column has existed since
  /// R0.1; OD9.1 added the physical foreign key, so it is now declared as a relation.
  event                      Event?                 @relation(fields: [event_id], references: [id])

  @@unique([organization_id, activity_number], name: "org_activity_number")
  @@index([workpack_id, sequence_number])
  @@index([organization_id, event_id, deleted_at], name: "Activity_org_event_deleted_idx")
}

model Workpack {
  id                             String                       @id @db.Uuid
  organization_id                String                       @db.Uuid
  site_id                        String                       @db.Uuid
  workpack_number                String?
  workpack_id_code               String?                      @unique
  unit_code                      String?
  title                          String
  revision                       String?                      @default("R0")
  sap_work_order                 String?
  sap_notification               String?
  portfolio_id                   String?                      @db.Uuid
  sap_plant_maintenance_order    String?
  asset_id                       String?                      @db.Uuid
  unit_id                        String?                      @db.Uuid
  event_id                       String?                      @db.Uuid
  plant_id                       String?                      @db.Uuid
  system_id                      String?                      @db.Uuid
  discipline_id                  String?                      @db.Uuid
  contractor_id                  String?                      @db.Uuid
  work_type_id                   String?                      @db.Uuid
  work_type                      String?
  priority                       String?                      @default("Normal")
  scope_of_work                  String?
  planned_start_date             DateTime?                    @db.Timestamptz(3)
  planned_end_date               DateTime?                    @db.Timestamptz(3)
  estimated_manhours             Int?                         @default(0)
  status                         WorkpackStatus               @default(draft)
  overall_progress               Int?                         @default(0)
  is_locked                      Boolean?                     @default(false)
  locked_at                      DateTime?
  locked_by                      String?                      @db.Uuid
  created_by                     String                       @db.Uuid
  updated_by                     String?                      @db.Uuid
  created_at                     DateTime                     @default(now())
  updated_at                     DateTime                     @updatedAt
  deleted_at                     DateTime?
  template_id                    String?                      @db.Uuid
  equipment_type                 String?
  job_type                       String?
  equipment_technical_data       Json?                        @default("{}")
  ai_auto_filled                 Boolean                      @default(false)
  ai_auto_filled_at              DateTime?
  approval_status                String?                      @default("not_submitted")
  approval_submitted_at          DateTime?
  approval_decided_at            DateTime?
  approved_by_name               String?
  approved_by_email              String?
  approval_notes                 String?
  project_id                     String?
  /// OD9.3 — optional Project/STO WBS placement. Ownership is on the WBS node
  /// (exactly one of event_id / project_id). This is an association, not a second
  /// activity hierarchy and not Activity.project_id.
  wbs_node_id                    String?                      @db.Uuid
  /// M7.4 — Workpack Intelligence fields
  scope_item_id                  String?                      @db.Uuid
  readiness_score                Int?                         @default(0)
  compliance_score               Int?                         @default(0)
  activities                     Activity[]
  asset                          Asset?                       @relation(fields: [asset_id], references: [id])
  contractor                     Contractor?                  @relation(fields: [contractor_id], references: [id])
  User_Workpack_created_byToUser User                         @relation("Workpack_created_byToUser", fields: [created_by], references: [id])
  discipline                     Discipline?                  @relation(fields: [discipline_id], references: [id])
  event                          Event?                       @relation(fields: [event_id], references: [id])
  User_Workpack_locked_byToUser  User?                        @relation("Workpack_locked_byToUser", fields: [locked_by], references: [id])
  organization                   Organization                 @relation(fields: [organization_id], references: [id])
  plant                          Plant?                       @relation(fields: [plant_id], references: [id])
  project                        Project?                     @relation(fields: [project_id], references: [id])
  wbs_node                       WbsNode?                     @relation(fields: [wbs_node_id], references: [id], onDelete: SetNull)
  site                           Site                         @relation(fields: [site_id], references: [id])
  system                         System?                      @relation(fields: [system_id], references: [id])
  unit                           Unit?                        @relation(fields: [unit_id], references: [id])
  User_Workpack_updated_byToUser User?                        @relation("Workpack_updated_byToUser", fields: [updated_by], references: [id])
  instantiation                  WorkpackInstantiation?
  workpack_materials             WorkpackMaterial[]
  certificateInstances           CertificateInstance[]
  constraintLogs                 ConstraintLog[]
  lessonLearneds                 LessonLearned[]
  joint_integrity_items          JointIntegrityItem[]
  blinds                         Blind[]
  constraints                    Constraint[]
  punch_list_items               PunchListItem[]
  workpack_documents             WorkpackDocument[]
  document_instances             DocumentInstance[]
  form_instances                 FormInstance[]
  cleaning_records               cleaning_records[]
  workflow_transitions           WorkflowTransition[]
  versions                       WorkpackVersion[]
  attachments                    WorkpackAttachment[]
  workpack_material_lines        workpack_material_lines[]
  qa_clearance_records           qa_clearance_records[]
  dropping_boxup_checklists      dropping_boxup_checklists[]
  clearance_for_boxup            clearance_for_boxup?
  job_completion_certificate     job_completion_certificates?
  scope_items                    ScopeItem[]
  identity_review                WorkpackIdentityReview?
  /// M8.6 — asset snapshots taken when assets are attached (declared in OD9.1)
  asset_snapshots                workpack_asset_snapshots[]
  /// OD9.1 — live FK from Permit.workpack_id
  permits                        Permit[]

  @@unique([organization_id, workpack_number])
  @@index([organization_id, site_id, status])
  @@index([organization_id, status])
  /// OD9.1 — Event-scoped workpack reads
  @@index([event_id])
  @@index([wbs_node_id])
}

/// R0.4-D — identity review disposition. Not Workpack.status (operational).
/// Quarantine is a review state, not deletion.
model WorkpackIdentityReview {
  id                 String   @id @default(uuid()) @db.Uuid
  organization_id    String   @db.Uuid
  workpack_id        String   @unique @db.Uuid
  review_state       String   @default("UNREVIEWED")
  classification     String?
  confirmed_event_id String?  @db.Uuid
  previous_event_id  String?  @db.Uuid
  reason             String?
  evidence           Json     @default("{}")
  reviewer_id        String?  @db.Uuid
  approver_id        String?  @db.Uuid
  conflict_accepted  Boolean  @default(false)
  version            Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  workpack           Workpack @relation(fields: [workpack_id], references: [id], onDelete: Cascade)

  @@index([organization_id, review_state])
  @@map("workpack_identity_reviews")
}

model ProgressLog {
  id               String    @id @db.Uuid
  activity_id      String    @db.Uuid
  log_date         DateTime
  progress_percent Decimal
  manhours_actual  Decimal?
  logged_by        String?   @db.Uuid
  remarks          String?
  created_at       DateTime  @default(now())
  organization_id  String?   @db.Uuid
  recorded_at      DateTime? @default(now())
  data_date        DateTime?
  percent_complete Float?
  actual_cost      Float?
  recorded_by      String?   @db.Uuid
  /// M12-R0.1: Execution shift context (day/night)
  shift            String?   @default("day")
  /// M8.13 quantity-based progress inputs. Present in the database since the
  /// resource planning migration; previously undeclared.
  quantity_actual   Decimal? @db.Decimal(10, 2)
  quantity_unit     String?
  udf_definition_id String?  @db.Uuid
  Activity         Activity  @relation(fields: [activity_id], references: [id])
}

model ActivityLibrary {
  id                     String      @id @db.Uuid
  organization_id        String      @db.Uuid
  name                   String
  description            String?
  discipline_id          String?     @db.Uuid
  duration_hours         Decimal?    @db.Decimal(8, 2)
  is_active              Boolean?    @default(true)
  activity_code          String?
  created_by             String?     @db.Uuid
  created_at             DateTime    @default(now())
  updated_at             DateTime
  deleted_at             DateTime?
  hold_point_type        String?
  hold_point_description String?
  work_category          String?
  phase                  String?
  level_code             String?
  /// PLATFORM | TENANT — separates the seeded platform library from tenant-authored
  /// entries. Populated on all rows; previously undeclared.
  library_scope          String      @default("TENANT")
  discipline             Discipline? @relation(fields: [discipline_id], references: [id])
}

model ActivityLibraryUdfDefault {
  id                  String    @id @db.Uuid
  organization_id     String    @db.Uuid
  activity_library_id String    @db.Uuid
  udf_definition_id   String    @db.Uuid
  udf_option_id       String?   @db.Uuid
  value_string        String?
  value_number        Decimal?  @db.Decimal(10, 2)
  value_date          DateTime? @db.Timestamptz(3)
  value_boolean       Boolean?
  created_at          DateTime  @default(now())
  updated_at          DateTime
}

model ActivityRelationship {
  id                String            @id @db.Uuid
  organization_id   String            @db.Uuid
  predecessor_id    String            @db.Uuid
  successor_id      String            @db.Uuid
  relationship_type RelationshipType? @default(FS)
  /// Legacy whole-day lag. Retained for read fallback; new writes use lag_minutes.
  lag_days          Int?              @default(0)
  /// Sprint 1a — canonical lag in working minutes (sub-day capable).
  /// Engines convert via the calendar's hours_per_day. Backfilled lag_days × 480.
  lag_minutes       Int?
  created_by        String?           @db.Uuid
  created_at        DateTime          @default(now())
  updated_at        DateTime
  predecessor       Activity          @relation("activity_as_predecessor", fields: [predecessor_id], references: [id])
  successor         Activity          @relation("activity_as_successor", fields: [successor_id], references: [id])

  @@unique([predecessor_id, successor_id])
}

model ActivityResource {
  id               String        @id @db.Uuid
  organization_id  String        @db.Uuid
  workpack_id      String        @db.Uuid
  activity_id      String        @db.Uuid
  resource_type_id String?       @db.Uuid
  resource_id      String?       @db.Uuid
  contractor_id    String?       @db.Uuid
  planned_hours    Decimal?      @default(0) @db.Decimal(8, 2)
  actual_hours     Decimal?      @default(0) @db.Decimal(8, 2)
  headcount        Int?          @default(1)
  assigned_date    DateTime?     @db.Timestamptz(3)
  notes            String?
  created_by       String?       @db.Uuid
  created_at       DateTime      @default(now())
  updated_at       DateTime
  item_catalog_id  String?       @db.Uuid
  resource_type    ResourceType2 @default(labor)
  resource_name    String?
  crew_size        Int           @default(1)
  quantity         Decimal?      @db.Decimal(10, 4)
  unit             String?
  activity         Activity      @relation(fields: [activity_id], references: [id])
  organization     Organization  @relation(fields: [organization_id], references: [id])
  resource         Resource?     @relation(fields: [resource_id], references: [id])
}

model ActivityUdfDefinition {
  id                      String              @id @db.Uuid
  organization_id         String              @db.Uuid
  name                    String
  code                    String
  type                    String
  is_mandatory            Boolean?            @default(false)
  is_active               Boolean?            @default(true)
  /// M7.5 — Contractor Editable UDF flag
  is_contractor_editable  Boolean             @default(false)
  contractor_edit_label   String?             /// Optional label shown to contractor
  sort_order              Int?
  /// M8.13 — UDF rollup metadata. Present in the database since the resource
  /// planning migration; previously undeclared.
  is_exportable           Boolean             @default(false)
  is_progress_driving     Boolean             @default(false)
  unit                    String?
  /// M12-V1 — Dimension Registry metadata (enables unified filter/sort/group/export)
  is_filterable           Boolean             @default(true)
  is_sortable             Boolean             @default(true)
  is_groupable            Boolean             @default(true)
  is_bulk_editable        Boolean             @default(false)
  validation_rules        String?             /// JSON validation rules (optional)
  display_order           Int                 @default(0)
  width                   Int                 @default(150)
  created_by              String?             @db.Uuid
  created_at              DateTime            @default(now())
  updated_at              DateTime
  deleted_at              DateTime?
  activityUdfValues       ActivityUdfValue[]
  options                 ActivityUdfOption[]

  @@unique([organization_id, code])
}

model ActivityUdfOption {
  id                String                @id @db.Uuid
  organization_id   String                @db.Uuid
  udf_definition_id String                @db.Uuid
  value             String
  label             String
  code_value        String?
  description       String?
  sort_order        Int?                  @default(0)
  is_active         Boolean?              @default(true)
  created_by        String?               @db.Uuid
  created_at        DateTime              @default(now())
  updated_at        DateTime
  deleted_at        DateTime?
  udf_definition    ActivityUdfDefinition @relation(fields: [udf_definition_id], references: [id])

  @@unique([udf_definition_id, code_value])
}

model ActivityUdfValue {
  id                String                @id @db.Uuid
  organization_id   String                @db.Uuid
  activity_id       String                @db.Uuid
  udf_definition_id String                @db.Uuid
  udf_option_id     String?               @db.Uuid
  value_string      String?
  value_number      Decimal?              @db.Decimal(10, 2)
  value_date        DateTime?             @db.Timestamptz(3)
  value_boolean     Boolean?
  created_at        DateTime              @default(now())
  updated_at        DateTime
  activity          Activity              @relation(fields: [activity_id], references: [id])
  organization      Organization          @relation(fields: [organization_id], references: [id])
  udf_definition    ActivityUdfDefinition @relation(fields: [udf_definition_id], references: [id])

  @@unique([activity_id, udf_definition_id])
}

model AiExtractionJob {
  id                      String       @id @db.Uuid
  organization_id         String       @db.Uuid
  site_id                 String?      @db.Uuid
  requested_by            String       @db.Uuid
  workpack_id             String?      @db.Uuid
  status                  AiJobStatus?
  provider_used           String?
  model_used              String?
  started_at              DateTime?
  completed_at            DateTime?
  processing_seconds      Int?
  input_tokens            Int?
  output_tokens           Int?
  estimated_cost_usd      Decimal?     @db.Decimal(10, 6)
  error_message           String?
  retry_count             Int?         @default(0)
  next_retry_at           DateTime?
  work_type_hint          String?
  discipline_hint         String?
  additional_instructions String?
  created_by              String?      @db.Uuid
  created_at              DateTime     @default(now())
  updated_at              DateTime
  deleted_at              DateTime?

  @@index([organization_id, status])
  @@index([requested_by, created_at])
}

model AiExtractionResult {
  id                        String                @id @db.Uuid
  organization_id           String                @db.Uuid
  ai_extraction_job_id      String                @unique @db.Uuid
  raw_ai_response           String?
  extracted_data_json       Json
  planner_review_json       Json?
  review_status             DocumentReviewStatus? @default(pending_review)
  reviewed_by               String?               @db.Uuid
  reviewed_at               DateTime?
  review_notes              String?
  overall_confidence        Float?
  field_confidence_json     Json?
  low_confidence_fields     Json?
  materials_extracted       Int?                  @default(0)
  materials_matched_catalog Int?                  @default(0)
  materials_unmatched       Int?                  @default(0)
  created_at                DateTime              @default(now())
  updated_at                DateTime
}

model AiProviderSetting {
  id                         String   @id @db.Uuid
  organization_id            String   @unique @db.Uuid
  provider                   String?  @default("anthropic")
  model                      String?
  api_key_encrypted          String?
  api_endpoint               String?
  api_version                String?
  max_tokens                 Int?     @default(4096)
  temperature                Float?   @default(0.1)
  is_active                  Boolean? @default(false)
  extraction_prompt          String?
  fallback_provider          String?
  fallback_api_key_encrypted String?
  fallback_model             String?
  created_by                 String?  @db.Uuid
  updated_by                 String?  @db.Uuid
  created_at                 DateTime @default(now())
  updated_at                 DateTime
  vision_provider            String?
  vision_model               String?
  vision_api_key_encrypted   String?
  whatsapp_provider          String?  @default("openai")
  whatsapp_model             String?  @default("gpt-4o-mini")
  whatsapp_api_key_encrypted String?
  whisper_api_key_encrypted  String?
  lessons_provider           String?
  lessons_model              String?
}

model AiSuggestedItem {
  id                        String               @id @db.Uuid
  organization_id           String               @db.Uuid
  site_id                   String?              @db.Uuid
  ai_extraction_job_id      String               @db.Uuid
  workpack_material_id      String?              @db.Uuid
  suggested_name            String
  suggested_material_number String?
  suggested_category        String?
  suggested_uom             String?
  suggested_specifications  String?
  suggested_quantity        Decimal?             @db.Decimal(12, 3)
  source_document           String?
  confidence_score          Float?
  ai_reasoning              String?
  status                    SuggestedItemStatus? @default(pending_review)
  resolved_item_catalog_id  String?              @db.Uuid
  reviewed_by               String?              @db.Uuid
  reviewed_at               DateTime?
  review_notes              String?
  created_at                DateTime             @default(now())
  updated_at                DateTime

  @@index([organization_id, status])
}

model Asset {
  id                                         String          @id @default(uuid()) @db.Uuid
  organization_id                            String          @db.Uuid
  site_id                                    String          @db.Uuid
  /// Optional denormalized parents for Workpack / reporting (System remains primary link).
  plant_id                                   String?         @db.Uuid
  unit_id                                    String?         @db.Uuid
  system_id                                  String?         @db.Uuid
  tag_number                                 String
  name                                       String
  asset_type                                 String?
  /// M8.13 — Normalized equipment type FK (supplements free-text asset_type)
  equipment_type_id                          String?
  equipment_type_rel                         EquipmentType? @relation(fields: [equipment_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sap_equipment_number                       String?
  description                                String?
  is_active                                  Boolean?        @default(true)
  /// M8.14-R1 — Controlled lifecycle status (replaces boolean is_active for new code)
  status                                     AssetStatus     @default(draft)
  created_by                                 String?         @db.Uuid
  created_at                                 DateTime        @default(now())
  updated_at                                 DateTime        @updatedAt
  /// M8.14-R1 — Track who last modified this equipment record
  updated_by                                 String?         @db.Uuid
  deleted_at                                 DateTime?
  /// M8.14-R1 — Provenance: manual | excel_import | ai_extraction | p_and_id
  data_source                                String?         @default("manual")
  manufacturer                               String?
  model_number                               String?
  serial_number                              String?
  year_installed                             Int?
  design_pressure_barg                       Float?
  design_temp_c                              Float?
  operating_pressure_barg                    Float?
  operating_temp_c                           Float?
  test_pressure_barg                         Float?
  weight_empty_kg                            Float?
  weight_operating_kg                        Float?
  service_description                        String?
  fluid_service                              String?
  /// M8.14-R1 — Controlled criticality (was free-text String?)
  criticality                                AssetCriticality?
  p_and_id_numbers                           String[]        @default([])
  ga_drawing_number                          String?
  isometric_drawing_numbers                  String[]        @default([])
  plot_area                                  String?
  elevation                                  String?
  train                                      String?
  sap_functional_location                    String?
  extracted_from_document_id                 String?         @db.Uuid
  /// M8.14-R1 — Parent/child self-relation for equipment hierarchy
  parent_id                                  String?         @db.Uuid
  /// OD9.1: earlier, redundant hierarchy column. Physically present with its own FK
  /// and index; unpopulated. Declared to preserve the live constraint. `parent_id` is
  /// the column application code uses — see OD9-033.
  parent_asset_id                            String?         @db.Uuid
  /// OD9.1: live columns from the asset register SQL, previously undeclared. All empty.
  area_id                                    String?         @db.Uuid
  corrosion_loop_id                          String?
  design_code                                String?
  extraction_confidence                      Float?
  User                                       User?           @relation(fields: [created_by], references: [id])
  Organization                               Organization    @relation(fields: [organization_id], references: [id])
  Site                                       Site            @relation(fields: [site_id], references: [id])
  plant                                      Plant?          @relation(fields: [plant_id], references: [id])
  unit                                       Unit?           @relation(fields: [unit_id], references: [id])
  system                                     System?         @relation(fields: [system_id], references: [id])
  Workpack                                   Workpack[]
  asset_lines                                asset_lines[]
  joint_masters                              joint_masters[]
  line_lists_line_lists_from_asset_idToAsset line_lists[]    @relation("line_lists_from_asset_idToAsset")
