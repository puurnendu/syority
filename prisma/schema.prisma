enum TemplateLibraryScope {
  PLATFORM
  TENANT
  KNOWLEDGE
}

enum TemplateLifecycleStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// Enterprise Workpack Template — versioned planning knowledge (M6.1–M6.2).
model workpack_templates {
  id                 String                  @id @db.Uuid
  organization_id    String?                 @db.Uuid
  /// Stable identity across revisions
  template_family_id String                  @db.Uuid
  revision           Int                     @default(1)
  version_label      String?
  /// PLATFORM | TENANT | KNOWLEDGE
  library_scope      TemplateLibraryScope    @default(TENANT)
  lifecycle_status   TemplateLifecycleStatus @default(DRAFT)
  name               String
  category           String?
  equipment_type     String
  equipment_class    String?
  job_type           String                  /// Legacy — new code uses work_type_id
  work_type_id       String?                 @db.Uuid
  /// Relation to TemplateFamily
  template_family    TemplateFamily?         @relation(fields: [template_family_id], references: [id])
  discipline_id      String?                 @db.Uuid
  description        String?
  /// Section payloads (Planning metrics, Materials, Safety, QA/QC, References, AI)
  planning_json      Json                    @default("{}")
  resources_json     Json                    @default("[]")
  materials_json     Json                    @default("[]")
  safety_json        Json                    @default("{}")
  qaqc_json          Json                    @default("{}")
  references_json    Json                    @default("[]")
  ai_metadata_json   Json                    @default("{}")
  is_system          Boolean                 @default(false)
  is_active          Boolean                 @default(true)
  created_by         String                  @db.Uuid
  updated_by         String?                 @db.Uuid
  published_at       DateTime?
  deprecated_at      DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime
  deleted_at         DateTime?
  cloned_from_id     String?                 @db.Uuid
  knowledge_asset_id String?                 @db.Uuid

  @@unique([template_family_id, revision])
  @@index([library_scope, lifecycle_status])
  @@index([organization_id, name])
}

