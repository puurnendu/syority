model Event {
  id               String           @id @db.Uuid
  organization_id  String           @db.Uuid
  site_id          String           @db.Uuid
  /// Parent event for multi-shutdown campaigns (child = linked shutdown window)
  parent_event_id  String?          @db.Uuid
  name             String
  code             String
  event_type       String           @default("turnaround")
  planned_start    DateTime?        @db.Timestamptz(3)
  planned_end      DateTime?        @db.Timestamptz(3)
  actual_start     DateTime?        @db.Timestamptz(3)
  actual_end       DateTime?        @db.Timestamptz(3)
  status           String           @default("planning")
  scope_notes      String?
  description      String?
  budget_manhours  Int?
  budget_cost      Decimal?         @db.Decimal(15, 2)
  calendar_id      String?          @db.Uuid
  discipline_id    String?          @db.Uuid
  created_by       String?          @db.Uuid
  created_at       DateTime         @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  SafetyIncident   SafetyIncident[]
  SafetyLog        SafetyLog[]
  SafetyPhoto      SafetyPhoto[]
  Workpack         Workpack[]
  eventSystems     EventSystem[]
  eventUnits       EventUnit[]
  milestones       EventMilestone[]
  parentEvent      Event?           @relation("EventShutdownTree", fields: [parent_event_id], references: [id])
  childEvents      Event[]          @relation("EventShutdownTree")
  user             User?            @relation(fields: [created_by], references: [id])
  organization     Organization     @relation(fields: [organization_id], references: [id])
  site             Site             @relation(fields: [site_id], references: [id])
  calendar         ScheduleCalendar? @relation(fields: [calendar_id], references: [id])
  discipline       Discipline?      @relation(fields: [discipline_id], references: [id])
  wbsNodes         WbsNode[]
  shutdown_scope   ShutdownScope?
  /// M8.11 — Scope Change & Discovery
  discoveryWork    DiscoveryWork[]
  scopeChanges     ScheduleScopeChange[]
  /// M8.12 — Material Constraints
  materialConstraints MaterialConstraint[]
  /// M8.8 — Schedule Baselines
  scheduleBaselines   ScheduleBaseline[]
  /// M8.9 — Schedule Scenarios
  scheduleScenarios   ScheduleScenario[]
  /// M8.9 — Resource planning (live tables declared in OD9.1)
  shiftDefinitions    ShiftDefinition[]
  resourceCapacities  ResourceCapacity[]
  /// M8.8 — schedule change requests (live FK declared in OD9.1)
  scheduleChangeRequests ScheduleChangeRequest[]
  /// R0.4 / OD9.1 — activities scoped to this event (FK created in OD9.1)
  activities             Activity[]

  @@index([organization_id, status])
  @@index([site_id])
  @@index([parent_event_id])
  @@map("events")
}

