/// M16-R1: Interaction audit log for all M16 governed interactions
model m16_interaction_logs {
  id                String   @id @default(uuid()) @db.Uuid
  organization_id   String   @db.Uuid
  user_id           String   @db.Uuid
  event_id          String?  @db.Uuid
  channel           String   /// web | whatsapp | voice | mobile | api
  conversation_id   String?
  message_id        String?  /// Channel-specific message ID
  intent            String?  /// M16Intent enum value
  intent_category   String?  /// QUERY | NAVIGATION | EXECUTION | GOVERNANCE
  raw_message       String?  /// Original user text (for audit, NOT for re-processing)
  resolved_entity   Json?    /// { assetId?, workpackId?, activityId?, entityType? }
  action_risk_level String?  /// READ | LOW_RISK_WRITE | HIGH_RISK_WRITE | DESTRUCTIVE | GOVERNANCE
  authorization     String   @default("pending") /// authorized | denied | not_required
  denied_reason     String?
  confirmation      String?  /// not_required | pending | confirmed | rejected
  result            String   @default("pending") /// success | failure | ambiguous | rejected
  result_detail     String?
  identity_source   String?  /// session_cookie | phone_number | oauth_token | api_key
  source_channel    String?  /// Adapter-specific source info
  created_at        DateTime @default(now())

  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([event_id])
  @@index([channel, created_at])
}

