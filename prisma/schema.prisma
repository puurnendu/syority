enum IssueStatus {
  draft
  pending_review
  matched
  unmatched
  duplicate
  resolved
  rejected
}

enum IssuePriority {
  critical
  high
  medium
  low
  unclassified
}

/// Import batch — container for a set of issues from one source.
model IssueBatch {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  site_id             String?             @db.Uuid
  name                String              /// Human label, e.g. "Mech Dept Q3 2026"
  description         String?
  source_type         String              /// excel, csv, pdf, word, email, whatsapp, api, cmms, sap, maximo, manual, inspection
  source_filename     String?
  source_department   String?             /// Department that submitted this batch
  uploaded_by         String              @db.Uuid
  total_rows          Int                 @default(0)
  matched_count       Int                 @default(0)
  unmatched_count     Int                 @default(0)
  duplicate_count     Int                 @default(0)
  error_count         Int                 @default(0)
  status              String              @default("pending") /// pending, processing, completed, rolled_back
  column_mapping_id   String?             @db.Uuid
  ai_extraction_used  Boolean             @default(false)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  issues              EngineeringIssue[]
  Organization        Organization        @relation(fields: [organization_id], references: [id])

  @@index([organization_id, status])
  @@index([organization_id, source_department])
  @@map("issue_batches")
}

/// Core engineering issue — linked to Asset, classified, audited.
model EngineeringIssue {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  site_id             String?             @db.Uuid
  batch_id            String?             @db.Uuid
  issue_number        String?             /// Original issue number from source
  /// Raw equipment tag from source (before matching)
  equipment_tag_raw   String?
  equipment_desc_raw  String?
  /// Matched asset (null = unmatched or pending review)
  asset_id            String?             @db.Uuid
  match_confidence    Float?              /// 0.0–1.0 matching confidence
  match_method        String?             /// exact, normalized, fuzzy, manual, placeholder
  /// Hierarchy context (resolved from asset or from import)
  plant_id            String?             @db.Uuid
  unit_id             String?             @db.Uuid
  system_id           String?             @db.Uuid
  /// Issue content
  department          String?             /// Process, Maintenance, Inspection, Mechanical, etc.
  discipline          String?             /// AI-classified discipline
  problem             String              /// The engineering problem description
  recommendation      String?
  priority            IssuePriority       @default(unclassified)
  severity            String?             /// critical, major, minor, cosmetic
  status              IssueStatus         @default(draft)
  target_ta           String?             /// Target turnaround / event name (free text for now)
  originator          String?             /// Person who raised the issue
  raised_date         DateTime?           @db.Date
  due_date            DateTime?           @db.Date
  comments            String?
  /// AI enrichment
  ai_discipline       String?             /// AI-suggested discipline
  ai_discipline_confidence Float?
  ai_failure_mode     String?             /// AI-detected failure mode
  ai_category         String?             /// AI-recommended category
  ai_template_hint    String?             /// Suggested workpack template (future use, never auto-creates)
  ai_drawing_refs     String[]            @default([]) /// Drawing references found in text
  /// Metadata
  created_by          String?             @db.Uuid
  updated_by          String?             @db.Uuid
  reviewed_by         String?             @db.Uuid
  reviewed_at         DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  batch               IssueBatch?         @relation(fields: [batch_id], references: [id])
  asset               Asset?              @relation(fields: [asset_id], references: [id])
  Organization        Organization        @relation(fields: [organization_id], references: [id])
  attachments         IssueAttachment[]
  audit_logs          IssueAuditLog[]
  classifications     IssueClassification[]
  duplicates_as_a     IssueDuplicate[]    @relation("IssueDuplicateA")
  duplicates_as_b     IssueDuplicate[]    @relation("IssueDuplicateB")
  scope_links         ScopeItemIssueLink[]

  @@unique([organization_id, issue_number], name: "issue_org_number")
  @@index([organization_id, status])
  @@index([organization_id, department])
  @@index([organization_id, asset_id])
  @@index([batch_id])
  @@index([equipment_tag_raw])
  @@map("engineering_issues")
}

/// File attachment linked to an engineering issue.
model IssueAttachment {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  filename            String
  stored_path         String
  mime_type           String?
  file_size_bytes     Int?
  uploaded_by         String?             @db.Uuid
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id])
  @@map("issue_attachments")
}

/// Audit trail for every status change, edit, or merge on an issue.
model IssueAuditLog {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  user_id             String?             @db.Uuid
  action              String              /// create, update, match, unmatch, classify, merge, resolve, reject, attach
  field_name          String?
  old_value           String?
  new_value           String?
  notes               String?
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id, created_at])
  @@map("issue_audit_logs")
}

/// Detected duplicate pair with planner resolution.
model IssueDuplicate {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  issue_a_id          String              @db.Uuid
  issue_b_id          String              @db.Uuid
  similarity_score    Float               /// 0.0–1.0 text/semantic similarity
  similarity_method   String              /// text, ai_semantic, tag_match
  ai_reasoning        String?             /// AI explanation of why these are duplicates
  resolution          String?             /// merge_into_a, merge_into_b, keep_separate, rejected
  resolved_by         String?             @db.Uuid
  resolved_at         DateTime?
  created_at          DateTime            @default(now())
  issue_a             EngineeringIssue    @relation("IssueDuplicateA", fields: [issue_a_id], references: [id], onDelete: Cascade)
  issue_b             EngineeringIssue    @relation("IssueDuplicateB", fields: [issue_b_id], references: [id], onDelete: Cascade)

  @@unique([issue_a_id, issue_b_id])
  @@index([organization_id])
  @@map("issue_duplicates")
}

/// Persisted column mapping template for repeated imports.
model IssueColumnMapping {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  name                String              /// e.g. "SAP PM Export", "CMMS Standard"
  source_type         String              /// excel, csv, cmms, sap, maximo
  mappings            Json                /// { "Excel Column Name": "issue_field_name", ... }
  is_default          Boolean             @default(false)
  created_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@index([organization_id, source_type])
  @@map("issue_column_mappings")
}

/// AI classification result per issue — stores per-discipline confidence.
model IssueClassification {
  id                  String              @id @default(uuid()) @db.Uuid
  issue_id            String              @db.Uuid
  discipline          String              /// Mechanical, Inspection, Electrical, etc.
  confidence          Float               /// 0.0–1.0
  failure_mode        String?
  category            String?
  template_hint       String?             /// Suggested template name (never auto-creates)
  ai_model_used       String?
  created_at          DateTime            @default(now())
  issue               EngineeringIssue    @relation(fields: [issue_id], references: [id], onDelete: Cascade)

  @@index([issue_id])
  @@map("issue_classifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// M7.3 — Shutdown Scope Manager
// ─────────────────────────────────────────────────────────────────────────────

enum ScopeStatus {
  draft
  review
  approved
  frozen
  closed
}

enum ScopeChangeType {
  added
  removed
  deferred
  cancelled
  modified
  emergency
  opportunity
}

/// Top-level scope container. 1:1 with Event. Owns all ScopeItems.
model ShutdownScope {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  event_id            String              @unique @db.Uuid
  site_id             String              @db.Uuid
  /// Scope metadata
  name                String              /// e.g. "TA-2028 Shutdown Scope"
  description         String?
  objectives          String?             /// Scope objectives / goals
  status              ScopeStatus         @default(draft)
  /// Planning dates
  freeze_date         DateTime?           @db.Date
  frozen_at           DateTime?
  frozen_by           String?             @db.Uuid
  approved_at         DateTime?
  approved_by         String?             @db.Uuid
  closed_at           DateTime?
  closed_by           String?             @db.Uuid
  /// Budget placeholders
  budget_manhours     Int?
  budget_cost         Decimal?            @db.Decimal(15, 2)
  /// Aggregated stats (denormalized for dashboard)
  total_items         Int                 @default(0)
  total_estimated_hrs Int                 @default(0)
  /// Audit
  created_by          String              @db.Uuid
  updated_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// Relations
  event               Event               @relation(fields: [event_id], references: [id])
  organization        Organization        @relation(fields: [organization_id], references: [id])
  items               ScopeItem[]
  change_requests     ScopeChangeRequest[]
  deferrals           ScopeDeferral[]
  audit_logs          ScopeAuditLog[]
  packages            ScopePackage[]
  comparisons_as_a    ScopeComparison[]   @relation("ScopeCompareA")
  comparisons_as_b    ScopeComparison[]   @relation("ScopeCompareB")

  @@index([organization_id, status])
  @@map("shutdown_scopes")
}

/// Individual scope item — one asset's work for this shutdown.
model ScopeItem {
  id                  String              @id @default(uuid()) @db.Uuid
  organization_id     String              @db.Uuid
  scope_id            String              @db.Uuid
  /// Asset linkage (required — every scope item tied to an asset)
  asset_id            String              @db.Uuid
  /// Hierarchy context (denormalized from asset for fast filtering)
  plant_id            String?             @db.Uuid
  unit_id             String?             @db.Uuid
  system_id           String?             @db.Uuid
  /// Scope detail
  reason              String              /// Why this asset is in scope
  discipline          String?             /// Mechanical, Electrical, Inspection, etc.
  priority            String              @default("medium") /// critical, high, medium, low
  complexity          String              @default("standard") /// simple, standard, complex, critical
  requested_by        String?             /// Person or department who requested
  estimated_hours     Int                 @default(0)
  /// Template recommendation (advisory, never auto-creates workpack)
  template_id         String?             @db.Uuid
  template_name       String?             /// Denormalized for display
  /// AI enrichment
  ai_recommendation   String?             /// include / exclude
  ai_confidence       Float?
  ai_grouping_hint    String?             /// Suggested package grouping
  ai_missing_docs     String[]            @default([])
  ai_previous_ta      String?             /// Previous TA reference
  /// Planner notes
  planner_notes       String?
  /// Status tracking
  is_deferred         Boolean             @default(false)
  is_additional       Boolean             @default(false) /// Late addition / emergency / opportunity
  additional_type     String?             /// late_addition, emergency, opportunity
  /// Package assignment
  package_id          String?             @db.Uuid
  /// Sort & order
  sort_order          Int                 @default(0)
  /// Audit
  created_by          String              @db.Uuid
  updated_by          String?             @db.Uuid
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  /// Relations
  scope               ShutdownScope       @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  asset               Asset               @relation("ScopeItemAsset", fields: [asset_id], references: [id])
  package             ScopePackage?       @relation(fields: [package_id], references: [id])
  issue_links         ScopeItemIssueLink[]
  deferrals           ScopeDeferral[]
  /// M7.4 — Workpack created from this scope item
  workpack_id         String?             @db.Uuid
  workpack            Workpack?           @relation(fields: [workpack_id], references: [id])

  @@index([scope_id, discipline])
  @@index([scope_id, priority])
  @@index([asset_id])
  @@index([package_id])
  @@unique([scope_id, asset_id], name: "scope_asset_unique")
  @@map("scope_items")
}

/// Many-to-many join: ScopeItem ↔ EngineeringIssue.
model ScopeItemIssueLink {
  id          String            @id @default(uuid()) @db.Uuid
  scope_item_id String          @db.Uuid
  issue_id    String            @db.Uuid
  created_at  DateTime          @default(now())
  scope_item  ScopeItem         @relation(fields: [scope_item_id], references: [id], onDelete: Cascade)
  issue       EngineeringIssue  @relation(fields: [issue_id], references: [id])

  @@unique([scope_item_id, issue_id])
  @@index([issue_id])
  @@map("scope_item_issue_links")
}

/// Post-freeze change request.
model ScopeChangeRequest {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  scope_id        String            @db.Uuid
  /// What changed
  change_type     ScopeChangeType
  scope_item_id   String?           @db.Uuid   /// Item being changed (null for additions)
  asset_id        String?           @db.Uuid   /// Asset for new additions
  /// Details
  title           String
  reason          String
  justification   String?
  estimated_hours Int?
  discipline      String?
  priority        String?
  /// Approval
  status          String            @default("pending") /// pending, approved, rejected
  submitted_by    String            @db.Uuid
  submitted_at    DateTime          @default(now())
  reviewed_by     String?           @db.Uuid
  reviewed_at     DateTime?
  review_notes    String?
  /// Applied
  applied_at      DateTime?
  applied_by      String?           @db.Uuid
  /// Audit
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  /// Relations
  scope           ShutdownScope     @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([scope_id, status])
  @@index([organization_id])
  @@map("scope_change_requests")
}

/// Deferred work — never deleted. Permanent record.
model ScopeDeferral {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  scope_id        String          @db.Uuid
  scope_item_id   String          @db.Uuid
  /// Deferral info
  reason          String
  deferred_by     String          @db.Uuid
  deferred_at     DateTime        @default(now())
  target_event    String?         /// Name of next TA (free text)
  target_event_id String?         @db.Uuid   /// Link to next event if known
  /// Carry-forward tracking
  carried_forward Boolean         @default(false)
  carried_to_scope_id String?     @db.Uuid
  carried_at      DateTime?
  /// Relations
  scope           ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  scope_item      ScopeItem       @relation(fields: [scope_item_id], references: [id])

  @@index([scope_id])
  @@index([organization_id])
  @@map("scope_deferrals")
}

/// Scope-level audit log.
model ScopeAuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  scope_id    String          @db.Uuid
  user_id     String?         @db.Uuid
  action      String          /// create, add_item, remove_item, update_item, freeze, approve, close, change_request, defer, carry_forward, clone
  entity_type String?         /// scope_item, change_request, deferral, package
  entity_id   String?         @db.Uuid
  old_value   String?
  new_value   String?
  notes       String?
  created_at  DateTime        @default(now())
  scope       ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@index([scope_id, created_at])
  @@map("scope_audit_logs")
}

/// Logical grouping of scope items for handover.
model ScopePackage {
  id              String          @id @default(uuid()) @db.Uuid
  organization_id String          @db.Uuid
  scope_id        String          @db.Uuid
  name            String          /// e.g. "Mechanical Package A", "Inspection — Vessels"
  package_type    String          @default("discipline") /// discipline, area, contractor, risk, custom
  discipline      String?
  area            String?
  contractor      String?
  risk_level      String?
  description     String?
  estimated_hours Int             @default(0)
  sort_order      Int             @default(0)
  created_by      String          @db.Uuid
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  /// Relations
  scope           ShutdownScope   @relation(fields: [scope_id], references: [id], onDelete: Cascade)
  items           ScopeItem[]

  @@index([scope_id])
  @@unique([scope_id, name], name: "scope_package_name")
  @@map("scope_packages")
}

/// Comparison snapshot between two shutdowns.
model ScopeComparison {
  id            String          @id @default(uuid()) @db.Uuid
  organization_id String        @db.Uuid
  scope_a_id    String          @db.Uuid
  scope_b_id    String          @db.Uuid
  /// Summary counts
  total_added   Int             @default(0)
  total_removed Int             @default(0)
  total_deferred Int            @default(0)
  total_same    Int             @default(0)
  /// Detail stored as JSON for flexible display
  diff_detail   Json            @default("[]")
  created_by    String          @db.Uuid
  created_at    DateTime        @default(now())
  /// Relations
  scope_a       ShutdownScope   @relation("ScopeCompareA", fields: [scope_a_id], references: [id])
  scope_b       ShutdownScope   @relation("ScopeCompareB", fields: [scope_b_id], references: [id])

  @@index([organization_id])
  @@map("scope_comparisons")
}

// ═══════════════════════════════════════════════════════════════════════
// M7.4 — WORKPACK INTELLIGENCE ENGINE
// ═══════════════════════════════════════════════════════════════════════

// MaintenanceStrategy REMOVED per ADR-0012.
// Workpack Templates are the only reusable execution object.
// See: docs/adr/ADR-0012-Workpack-Template-Architecture.md

/// Workpack Instantiation — full traceability record for every workpack created via the Intelligence Engine.
model WorkpackInstantiation {
  id                    String             @id @default(uuid()) @db.Uuid
  organization_id       String             @db.Uuid
  /// Core references
  workpack_id           String             @unique @db.Uuid
  scope_item_id         String?            @db.Uuid
  scope_id              String?            @db.Uuid
  /// Template snapshot
  template_id           String?            @db.Uuid
  template_revision     Int?
  template_family_id    String?            @db.Uuid
  /// Asset context
  asset_id              String?            @db.Uuid
  event_id              String?            @db.Uuid
  /// Scores (computed, cached)
  readiness_score       Int                @default(0)
  compliance_score      Int                @default(100)
  readiness_detail      Json               @default("{}")
  compliance_detail     Json               @default("{}")
  /// AI context (advisory) — recommends templates only (ADR-0012)
  ai_recommendations    Json               @default("{}")
  ai_recommended_template String?
  /// Materialization counts
  activities_created    Int                @default(0)
  resources_created     Int                @default(0)
  materials_created     Int                @default(0)
  certificates_created  Int                @default(0)
  documents_attached    Int                @default(0)
  /// Audit
  instantiated_by       String             @db.Uuid
  instantiated_at       DateTime           @default(now())
  /// Relations
  workpack              Workpack           @relation(fields: [workpack_id], references: [id], onDelete: Cascade)

  @@index([scope_id])
  @@index([scope_item_id])
  @@index([organization_id])
  @@map("workpack_instantiations")
}

// ═══════════════════════════════════════════════════════════════════════
// WORK TYPE MASTER & TEMPLATE FAMILY (ADR-0012)
// ═══════════════════════════════════════════════════════════════════════

/// Work Type Master — structured work classification for templates and reporting.
/// Two-level taxonomy: Category (e.g. Mechanical) → Name (e.g. Bundle Pulling).
/// Belongs to Planning, NOT Asset Integrity.
model WorkType {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String?  @db.Uuid  /// null = platform-level
  /// Two-level taxonomy
  category        String   /// e.g. "Mechanical", "Rotating", "Valve", "Inspection"
  name            String   /// e.g. "Bundle Pulling", "Pump Overhaul", "Hydro Test"
  code            String   /// e.g. "MECH-BP", "ROT-PO", "VLV-HT"
  description     String?
  /// Ordering and status
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  /// Audit
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([organization_id, code], name: "work_type_org_code")
  @@index([organization_id, category])
  @@map("work_types")
}

/// Template Family — groups related templates by equipment type and maintenance context.
/// Example: "Heat Exchanger Maintenance" family contains Bundle Pulling, Retubing, etc.
/// Planner workflow: Equipment → Equipment Type → Template Family → Template.
model TemplateFamily {
  id              String              @id @default(uuid()) @db.Uuid
  organization_id String?             @db.Uuid  /// null = platform-level
  /// Identity
  name            String              /// e.g. "Heat Exchanger Maintenance"
  code            String              /// e.g. "HX-MAINT"
  description     String?
  /// Equipment type linkage
  equipment_type  String              /// e.g. "Heat Exchanger", "Centrifugal Pump"
  /// Ordering and status
  sort_order      Int                 @default(0)
  is_active       Boolean             @default(true)
  /// Audit
  created_by      String?             @db.Uuid
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  /// Relations
  templates       workpack_templates[]

  @@unique([organization_id, code], name: "template_family_org_code")
  @@index([organization_id, equipment_type])
  @@map("template_families")
}
