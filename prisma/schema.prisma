/// OD9.1: realigned with the physical table. The previous declaration used TEXT
/// identifiers, omitted site_id and declared no relations, so `migrate diff` proposed
/// retyping six UUID columns to TEXT, rebuilding the primary key, dropping site_id and
/// dropping all four foreign keys plus the permit-number unique constraint. The table is
/// empty, so nothing was lost — but the declaration is now the catalogue.
model Permit {
  id               String    @id @db.Uuid
  /// M12-R0.1: Tenant isolation. NOT NULL in the database.
  organization_id  String    @db.Uuid
  site_id          String    @db.Uuid
  project_id       String?   @db.Uuid
  workpack_id      String?   @db.Uuid
  activity_id      String?   @db.Uuid
  permit_number    String
  permit_type      String
  work_description String?
  location         String?
  issued_by        String?   @db.Uuid
  issued_at        DateTime?
  valid_until      DateTime?
  extended_until   DateTime?
  status           String    @default("draft")
  precautions      String?
  gas_test_result  String?
  closed_by        String?   @db.Uuid
  closed_at        DateTime?
  remarks          String?
  created_at       DateTime  @default(now())
  updated_at       DateTime

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  site             Site         @relation(fields: [site_id], references: [id])
  workpack         Workpack?    @relation(fields: [workpack_id], references: [id])
  activity         Activity?    @relation(fields: [activity_id], references: [id])

  @@unique([organization_id, permit_number])
  @@index([organization_id, status])
  @@index([organization_id, site_id])
  @@index([workpack_id])
  @@index([activity_id])
}

