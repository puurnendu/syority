generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String?              @unique
  industry              String?
  country               String?
  timezone              String?              @default("UTC")
  logo_path             String?
  logoUrl               String?              @map("logo_url")
  logoWidthPx           Int?                 @default(140) @map("logo_width_px")
  logoHeightPx          Int?                 @default(40) @map("logo_height_px")
  sidebarLogoUrl        String?              @map("sidebar_logo_url")
  sidebarLogoWidthPx    Int?                 @default(120) @map("sidebar_logo_width_px")
  sidebarLogoHeightPx   Int?                 @default(36) @map("sidebar_logo_height_px")
  faviconUrl            String?              @map("favicon_url")
  primaryColor          String?              @default("#4F46E5") @map("primary_color")
  platformName          String?              @default("SYORITY") @map("platform_name")
  is_active             Boolean?             @default(true)
  settings              Json?
  activity_id_increment Int                  @default(3)
  workpackPdfColumns    Json?                @default("{\"showWindow\": true, \"showDuration\": true, \"showManpower\": false, \"showContractor\": true, \"showElectrical\": true, \"showPredecessor\": false, \"showScaffolding\": true}") @map("workpack_pdf_columns")
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  deleted_at            DateTime?
  contract_start_date   DateTime?
  contract_end_date     DateTime?
  contract_value        Float?
  currency              String?              @default("USD")
  billing_cycle         String?              @default("annual")
  payment_status        String?              @default("active")
  last_payment_date     DateTime?
  last_payment_amount   Float?
  payment_notes         String?
  plan_tier             String?              @default("professional")
  max_users             Int?                 @default(15)
  max_sites             Int?                 @default(3)
  feature_flags         Json?                @default("{}")
  status                String?              @default("active")
  suspended_at          DateTime?
  suspension_reason     String?
  terminated_at         DateTime?
  onboarded_by          String?
  onboarded_at          DateTime?
  account_manager       String?
  account_manager_email String?
  technical_contact     String?
  technical_email       String?
  notes                 String?
  deployment_model      String?              @default("shared")
  vps_hostname          String?
  vps_region            String?
  assets                Asset[]
  contractors           Contractor[]
  disciplines           Discipline[]
  plants                Plant[]
  resources             Resource[]
  resource_types        ResourceType[]
  roles                 Role[]
  sites                 Site[]
  systems               System[]
  units                 Unit[]
  users                 User[]
  user_roles            UserRole[]
  workpacks             Workpack[]
  report_templates      ReportTemplate[]
  scheduled_deliveries  ScheduledDelivery[]
  billing_logs          BillingLog[]
  events                Event[]
  joint_masters         JointMaster[]
  line_lists            LineList[]
  nozzles               Nozzle[]
  unit_responsibilities UnitResponsibility[]
  wbs_nodes             WbsNode[]
  workpack_materials    WorkpackMaterial[]

  @@index([is_active])
}

model BillingLog {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  recorded_by     String
  payment_date    DateTime
  amount          Float
  currency        String       @default("USD")
  reference       String?
  notes           String?
  created_at      DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id])

  @@map("billing_logs")
}

model Site {
  id                        String        @id @default(uuid()) @db.Uuid
  organization_id           String        @db.Uuid
  name                      String
  code                      String?
  location                  String?
  timezone                  String?       @default("UTC")
  is_active                 Boolean?      @default(true)
  created_by                String?       @db.Uuid
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt
  deleted_at                DateTime?
  pressure_test_standard    String        @default("ASME_VIII")
  hydrotest_multiplier      Float         @default(1.5)
  pneumatic_test_multiplier Float         @default(1.1)
  torque_standard           String        @default("ASME_PCC_1")
  test_standard_notes       String?
  assets                    Asset[]
  contractors               Contractor[]
  plants                    Plant[]
  resources                 Resource[]
  creator                   User?         @relation("SiteCreator", fields: [created_by], references: [id])
  organization              Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  systems                   System[]
  units                     Unit[]
  users                     User[]
  user_roles                UserRole[]
  workpacks                 Workpack[]
  events                    Event[]
  joint_masters             JointMaster[]
  line_lists                LineList[]
  workpack_materials        WorkpackMaterial[]

  @@unique([organization_id, code])
}

model Role {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  slug            String
  permissions     Json?
  is_system       Boolean?     @default(false)
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  creator         User?        @relation("RoleCreator", fields: [created_by], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_roles      UserRole[]

  @@unique([organization_id, slug])
}

model User {
  id                        String               @id @default(uuid()) @db.Uuid
  organization_id           String               @db.Uuid
  site_id                   String?              @db.Uuid
  name                      String
  email                     String               @unique
  employee_id               String?
  password                  String
  position                  String?
  phone                     String?
  whatsapp_number           String?              @unique
  whatsapp_verified         Boolean              @default(false)
  whatsapp_opt_in           Boolean              @default(false)
  preferred_language        String?              @default("en")
  avatar_path               String?
  is_active                 Boolean?             @default(true)
  last_login_at             DateTime?
  remember_token            String?
  is_super_admin            Boolean              @default(false)
  is_tenant_admin           Boolean              @default(false)
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  deleted_at                DateTime?
  created_assets            Asset[]              @relation("AssetCreator")
  created_contractors       Contractor[]         @relation("ContractorCreator")
  created_disciplines       Discipline[]         @relation("DisciplineCreator")
  created_plants            Plant[]              @relation("PlantCreator")
  created_resources         Resource[]           @relation("ResourceCreator")
  created_resource_types    ResourceType[]       @relation("ResourceTypeCreator")
  created_roles             Role[]               @relation("RoleCreator")
  created_sites             Site[]               @relation("SiteCreator")
  created_systems           System[]             @relation("SystemCreator")
  created_units             Unit[]               @relation("UnitCreator")
  organization              Organization         @relation(fields: [organization_id], references: [id])
  site                      Site?                @relation(fields: [site_id], references: [id])
  assigned_user_roles       UserRole[]           @relation("RoleAssignedBy")
  user_roles                UserRole[]
  created_workpacks         Workpack[]           @relation("WorkpackCreator")
  locked_workpacks          Workpack[]           @relation("WorkpackLocker")
  updated_workpacks         Workpack[]           @relation("WorkpackUpdater")
  report_templates          ReportTemplate[]
  scheduled_deliveries      ScheduledDelivery[]
  created_events            Event[]              @relation("EventCreator")
  system_blinds_responsible SystemBlind[]        @relation("SystemBlindResponsible")
  unit_responsibilities     UnitResponsibility[] @relation("UnitResponsibility")
}

model UserRole {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  user_id         String       @db.Uuid
  role_id         String       @db.Uuid
  site_id         String?      @db.Uuid
  assigned_by     String?      @db.Uuid
  assigned_at     DateTime?    @default(now())
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  assigner        User?        @relation("RoleAssignedBy", fields: [assigned_by], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  role            Role         @relation(fields: [role_id], references: [id], onDelete: Cascade)
  site            Site?        @relation(fields: [site_id], references: [id])
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, site_id])
}

model Plant {
  id              String       @id @default(uuid()) @db.Uuid
  organization_id String       @db.Uuid
  site_id         String       @db.Uuid
  name            String
  code            String?
  description     String?
  is_active       Boolean?     @default(true)
  created_by      String?      @db.Uuid
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  deleted_at      DateTime?
  creator         User?        @relation("PlantCreator", fields: [created_by], references: [id])
  organization    Organization @relation(fields: [organization_id], references: [id])
  site            Site         @relation(fields: [site_id], references: [id])
  units           Unit[]
  workpacks       Workpack[]
}

model Event {
  id               String           @id @default(uuid()) @db.Uuid
  organization_id  String           @db.Uuid
  site_id          String           @db.Uuid
  name             String
  code             String
  event_type       String           @default("turnaround")
  planned_start    DateTime?        @db.Date
  planned_end      DateTime?        @db.Date
  actual_start     DateTime?        @db.Date
  actual_end       DateTime?        @db.Date
  status           String           @default("planning")
  scope_notes      String?
  budget_manhours  Int?
  budget_cost      Decimal?         @db.Decimal(15, 2)
  created_by       String?          @db.Uuid
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  safety_incidents SafetyIncident[]
  safety_logs      SafetyLog[]
  safety_photos    SafetyPhoto[]
  workpacks        Workpack[]
  event_systems    EventSystem[]
  event_units      EventUnit[]
  creator          User?            @relation("EventCreator", fields: [created_by], references: [id])
  organization     Organization     @relation(fields: [organization_id], references: [id])
  site             Site             @relation(fields: [site_id], references: [id])
  wbs_nodes        WbsNode[]

  @@index([organization_id, status])
  @@index([site_id])
  @@map("events")
}

model SafetyLog {
  id                  String           @id @default(uuid()) @db.Uuid
  eventId             String           @map("event_id") @db.Uuid
  projectId           String?          @map("project_id") @db.Uuid
  logDate             DateTime         @map("log_date") @db.Date
  shift               String           @default("day")
  manpowerPlanned     Int              @default(0) @map("manpower_planned")
  manpowerActual      Int              @default(0) @map("manpower_actual")
  lti                 Int              @default(0)
  ltiDaysLost         Int              @default(0) @map("lti_days_lost")
  nearMiss            Int              @default(0) @map("near_miss")
  firstAid            Int              @default(0) @map("first_aid")
  medicalTreatment    Int              @default(0) @map("medical_treatment")
  dangerousOccurrence Int              @default(0) @map("dangerous_occurrence")
  ptwIssued           Int              @default(0) @map("ptw_issued")
  ptwClosed           Int              @default(0) @map("ptw_closed")
  ptwSuspended        Int              @default(0) @map("ptw_suspended")
  toolboxTalks        Int              @default(0) @map("toolbox_talks")
  manhoursWorked      Decimal          @default(0) @map("manhours_worked")
  manhoursPlanned     Decimal          @default(0) @map("manhours_planned")
  cumulativeManhours  Decimal          @default(0) @map("cumulative_manhours")
  cumulativeLti       Int              @default(0) @map("cumulative_lti")
  ltiFrequencyRate    Decimal          @default(0) @map("lti_frequency_rate")
  safetyNotes         String?          @map("safety_notes")
  submittedBy         String?          @map("submitted_by")
  submittedByName     String?          @map("submitted_by_name")
  lastUpdatedBy       String?          @map("last_updated_by")
  lastUpdatedByName   String?          @map("last_updated_by_name")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  incidents           SafetyIncident[]
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos              SafetyPhoto[]

  @@unique([eventId, logDate])
  @@index([eventId, logDate])
}

model SafetyIncident {
  id                  String        @id @default(uuid()) @db.Uuid
  safetyId            String?       @map("safety_id")
  safetyLogId         String        @map("safety_log_id") @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  incidentDate        DateTime      @map("incident_date")
  incidentTime        String?       @map("incident_time")
  incidentType        String        @map("incident_type")
  severity            String        @default("Low")
  title               String
  description         String
  location            String?
  unitArea            String?       @map("unit_area")
  contractor          String?
  personsInvolved     String?       @map("persons_involved")
  immediateAction     String?       @map("immediate_action")
  rootCause           String?       @map("root_cause")
  rootCauseCategory   String?       @map("root_cause_category")
  contributingFactors String?       @map("contributing_factors")
  correctiveActions   String?       @map("corrective_actions")
  preventiveActions   String?       @map("preventive_actions")
  lessonLearned       String?       @map("lesson_learned")
  actionOwner         String?       @map("action_owner")
  actionDueDate       DateTime?     @map("action_due_date") @db.Date
  actionCompletedDate DateTime?     @map("action_completed_date") @db.Date
  status              String        @default("Open")
  investigationBy     String?       @map("investigation_by")
  closedBy            String?       @map("closed_by")
  closedAt            DateTime?     @map("closed_at")
  remarks             String?
  reportedBy          String?       @map("reported_by")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  safetyLog           SafetyLog     @relation(fields: [safetyLogId], references: [id], onDelete: Cascade)
  photos              SafetyPhoto[]
}

model SafetyPhoto {
  id             String          @id @default(uuid()) @db.Uuid
  safetyLogId    String?         @map("safety_log_id") @db.Uuid
  incidentId     String?         @map("incident_id") @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  photoType      String          @default("general") @map("photo_type")
  caption        String?
  storagePath    String          @map("storage_path")
  publicUrl      String          @map("public_url")
  fileSize       Int?            @map("file_size")
  mimeType       String?         @map("mime_type")
  uploadedBy     String?         @map("uploaded_by")
  uploadedByName String?         @map("uploaded_by_name")
  takenAt        DateTime        @default(now()) @map("taken_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  incident       SafetyIncident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  safetyLog      SafetyLog?      @relation(fields: [safetyLogId], references: [id], onDelete: Cascade)
}

model EventUnit {
  id        String  @id @default(uuid()) @db.Uuid
  event_id  String  @db.Uuid
  unit_id   String  @db.Uuid
  is_active Boolean @default(true)
  notes     String?
  event     Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  unit      Unit    @relation(fields: [unit_id], references: [id])

  @@unique([event_id, unit_id])
  @@map("event_units")
}

model Unit {
  id               String               @id @default(uuid()) @db.Uuid
  organization_id  String               @db.Uuid
  site_id          String               @db.Uuid
  plant_id         String               @db.Uuid
  name             String
  code             String?
  description      String?
  is_active        Boolean?             @default(true)
  created_by       String?              @db.Uuid
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  deleted_at       DateTime?
  systems          System[]
  creator          User?                @relation("UnitCreator", fields: [created_by], references: [id])
  organization     Organization         @relation(fields: [organization_id], references: [id])
  plant            Plant                @relation(fields: [plant_id], references: [id])
  site             Site                 @relation(fields: [site_id], references: [id])
  workpacks        Workpack[]
  event_units      EventUnit[]
  line_lists       LineList[]
  responsibilities UnitResponsibility[]
}

model System {
  id              String            @id @default(uuid()) @db.Uuid
  organization_id String            @db.Uuid
  site_id         String            @db.Uuid
  unit_id         String            @db.Uuid
  code            String?
  name            String
  description     String?
  criticality     String?
  status          String            @default("Active")
  p_and_id_ref    String?
  is_active       Boolean?          @default(true)
  created_by      String?           @db.Uuid
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  deleted_at      DateTime?
  assets          Asset[]
  creator         User?             @relation("SystemCreator", fields: [created_by], references: [id])
  organization    Organization      @relation(fields: [organization_id], references: [id])
  site            Site              @relation(fields: [site_id], references: [id])
  unit            Unit              @relation(fields: [unit_id], references: [id])
  workpacks       Workpack[]
  events          EventSystem[]
  line_lists      LineList[]
  blinds          SystemBlind[]
  drawings        SystemDrawing[]
  gaskets         SystemGasket[]
  procedures      SystemProcedure[]
  wbs_nodes       WbsNode[]

  @@index([organization_id])
  @@index([site_id, unit_id])
}

model SystemBlind {
  id                  String    @id @default(uuid()) @db.Uuid
  system_id           String    @db.Uuid
  blind_id            String
  tag                 String
  line_number         String
  spec                String
  size                String
  material            String
  inserted_at         DateTime?
  removed_at          DateTime?
  status              String    @default("Pending")
  responsible_user_id String?   @db.Uuid
  workpack_id         String?   @db.Uuid
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  responsible_user    User?     @relation("SystemBlindResponsible", fields: [responsible_user_id], references: [id])
  system              System    @relation(fields: [system_id], references: [id], onDelete: Cascade)

  @@index([system_id])
  @@map("system_blinds")
}

model SystemGasket {
  id              String   @id @default(uuid()) @db.Uuid
  system_id       String   @db.Uuid
  gasket_id       String
  joint_ref       String
  line_number     String
  size            String
  pressure_rating String
  type            String
  material        String
  quantity        Int      @default(1)
  status          String   @default("Required")
  workpack_id     String?  @db.Uuid
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  system          System   @relation(fields: [system_id], references: [id], onDelete: Cascade)

  @@index([system_id])
  @@map("system_gaskets")
}

model SystemDrawing {
  id         String    @id @default(uuid()) @db.Uuid
  system_id  String    @db.Uuid
  drawing_no String
  title      String
  revision   String
  type       String
  status     String    @default("For Review")
  file_url   String?
  date       DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  system     System    @relation(fields: [system_id], references: [id], onDelete: Cascade)

  @@index([system_id])
  @@map("system_drawings")
}

model SystemProcedure {
  id           String   @id @default(uuid()) @db.Uuid
  system_id    String   @db.Uuid
  procedure_no String
  title        String
  type         String
  revision     String
  status       String   @default("Draft")
  owner        String?
  file_url     String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  system       System   @relation(fields: [system_id], references: [id], onDelete: Cascade)

  @@index([system_id])
  @@map("system_procedures")
}

model WbsNode {
  id                 String       @id @default(uuid()) @db.Uuid
  organization_id    String       @db.Uuid
  event_id           String       @db.Uuid
  system_id          String?      @db.Uuid
  parent_id          String?      @db.Uuid
  code               String
  name               String
  type               WbsNodeType
  order              Int          @default(0)
  locked             Boolean      @default(false)
  linked_entity_id   String?      @db.Uuid
  linked_entity_type String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  event              Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organization_id], references: [id])
  parent             WbsNode?     @relation("WbsTree", fields: [parent_id], references: [id])
  children           WbsNode[]    @relation("WbsTree")
  system             System?      @relation(fields: [system_id], references: [id])

  @@index([organization_id, event_id])
  @@index([system_id])
  @@index([parent_id])
  @@map("wbs_nodes")
}

model EventSystem {
  id        String @id @default(uuid()) @db.Uuid
  event_id  String @db.Uuid
  system_id String @db.Uuid
  event     Event  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  system    System @relation(fields: [system_id], references: [id], onDelete: Cascade)

  @@unique([event_id, system_id])
  @@map("event_systems")
}

model Asset {
  id                         String        @id @default(uuid()) @db.Uuid
  organization_id            String        @db.Uuid
  site_id                    String        @db.Uuid
  system_id                  String?       @db.Uuid
  tag_number                 String
  name                       String
  asset_type                 String?
  sap_equipment_number       String?
  description                String?
  is_active                  Boolean?      @default(true)
  created_by                 String?       @db.Uuid
  created_at                 DateTime      @default(now())
  updated_at                 DateTime      @updatedAt
  deleted_at                 DateTime?
  manufacturer               String?
  model_number               String?
  serial_number              String?
  year_installed             Int?
  design_pressure_barg       Float?
  design_temp_c              Float?
  operating_pressure_barg    Float?
  operating_temp_c           Float?
  test_pressure_barg         Float?
  weight_empty_kg            Float?
  weight_operating_kg        Float?
  service_description        String?
  fluid_service              String?
  criticality                String?
  maintenance_strategy       String?
  inspection_interval_months Int?
  p_and_id_numbers           String[]      @default([])
  ga_drawing_number          String?
  isometric_drawing_numbers  String[]      @default([])
  plot_area                  String?
  elevation                  String?
  train                      String?
  sap_functional_location    String?
  extracted_from_document_id String?       @db.Uuid
  extraction_confidence      Float?
  creator                    User?         @relation("AssetCreator", fields: [created_by], references: [id])
  organization               Organization  @relation(fields: [organization_id], references: [id])
  site                       Site          @relation(fields: [site_id], references: [id])
  system                     System?       @relation(fields: [system_id], references: [id])
  workpacks                  Workpack[]
  line_connections           AssetLine[]
  joint_masters              JointMaster[]
  lines_from                 LineList[]    @relation("LineFromAsset")
  lines_to                   LineList[]    @relation("LineToAsset")
  nozzles                    Nozzle[]

  @@unique([organization_id, tag_number])
}

model Nozzle {
  id                    String       @id @default(uuid()) @db.Uuid
  organization_id       String       @db.Uuid
  asset_id              String       @db.Uuid
  designation           String
  service               String?
  nominal_size_inches   Float?
  pressure_rating       String?
  flange_face           String?
  flange_standard       String?
  gasket_type           String?
  gasket_material       String?
  bolt_spec             String?
  bolt_count            Int?
  default_torque_nm     Float?
  p_and_id_number       String?
  connected_line_number String?
  is_active             Boolean      @default(true)
  sequence_number       Int?         @default(0)
  notes                 String?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  deleted_at            DateTime?
  joint_master          JointMaster?
  line_from             LineList[]   @relation("LineFromNozzle")
  line_to               LineList[]   @relation("LineToNozzle")
  asset                 Asset        @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organization_id], references: [id])

  @@index([asset_id])
