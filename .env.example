# ==============================================================
# Syority Platform — Environment Variables
# Copy this file to .env and fill in real values before running.
# ==============================================================

# --- Database ---
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/syority?schema=public"

# --- NextAuth / public app URL ---
# Must match the URL users actually open (host + port + scheme).
# Local Docker / next start default: http://localhost:3000
# Staging example: https://staging.syority.com
# Production example: https://app.syority.com
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-secret-here"

# --- Platform Admin (used by prisma/seed.ts) ---
PLATFORM_ADMIN_EMAIL="admin@syority.com"
PLATFORM_ADMIN_PASSWORD="CHANGE_ME"

# --- Email (SMTP) ---
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT="587"
SMTP_USER="noreply@syority.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="Syority Platform <noreply@syority.com>"

# --- AI ---
AI_MODEL="gpt-4o"
GEMINI_API_KEY="your-gemini-api-key"

# --- Vertex AI (Google Cloud enterprise AI) ---
# Option A: Service account JSON as base64 string (preferred for production)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_AI_SERVICE_ACCOUNT_JSON="base64-encoded-service-account-json"
# Option B: Path to service account JSON file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# --- Encryption ---
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
# Inside Docker Compose use: REDIS_URL="redis://redis:6379"
# (and DATABASE_URL="postgresql://user:pass@db:5432/syority?schema=public")

# --- Deployment (VPS) ---
DOMAIN="app.yourdomain.com"

# --- WhatsApp Webhook ---
WHATSAPP_VERIFY_TOKEN="change-me-to-a-random-token"

# --- File Storage ---
# "local" stores files under ./uploads (private, served via authed API routes).
# Set to "s3" to use AWS S3 (requires AWS_* vars below).
STORAGE_PROVIDER="local"
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
